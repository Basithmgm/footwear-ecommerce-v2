<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/sidebar', { path: '/admin/orders' }) %>

        <main class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
                <h2 class="h3 mb-0">Order Details</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/admin/orders">Orders</a></li>
                        <li class="breadcrumb-item active" aria-current="page">#<%=
                                order._id.toString().slice(-6).toUpperCase() %>
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="row">
                <!-- Left Column: Order Info & Items -->
                <div class="col-lg-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Order Items</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Product</th>
                                            <th>Price</th>
                                            <th>Quantity</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% let subtotal=0; let cancelledTotal=0; order.items.forEach(item=> {
                                            if (item.itemStatus === 'Cancelled') {
                                            cancelledTotal += item.itemTotal;
                                            } else {
                                            subtotal += item.itemTotal;
                                            }
                                            %>
                                            <tr class="<%= item.itemStatus === 'Cancelled' ? 'text-muted' : '' %>"
                                                <%=item.itemStatus==='Cancelled'
                                                ? 'style="text-decoration: line-through; opacity: 0.6;"' : '' %>>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <% if(item.image) { %>
                                                            <img src="<%= item.image %>" alt="<%= item.productName %>"
                                                                class="rounded me-3"
                                                                style="width: 50px; height: 50px; object-fit: cover;">
                                                            <% } else { %>
                                                                <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                                                    style="width: 50px; height: 50px;">
                                                                    <i class="fas fa-image text-muted"></i>
                                                                </div>
                                                                <% } %>
                                                                    <div>
                                                                        <h6 class="mb-0">
                                                                            <%= item.productName %>
                                                                        </h6>
                                                                        <small class="text-muted d-block mb-1">
                                                                            Color: <span class="fw-bold"
                                                                                style="color: <%= item.variantId || 'inherit' %>;">
                                                                                <%= item.variantId %>
                                                                            </span> |
                                                                            Size: <%= item.size %>
                                                                        </small>

                                                                        <!-- Display Item Level Status if applicable -->
                                                                        <% if (item.itemStatus && item.itemStatus
                                                                            !=='Ordered' ) { %>
                                                                            <span
                                                                                class="badge p-1 px-2 mt-1
                                                                                <%= item.itemStatus === 'Cancelled' || item.itemStatus === 'Return Rejected' ? 'bg-danger' : 
                                                                                    item.itemStatus === 'Returned' ? 'bg-dark' : 
                                                                                    item.itemStatus === 'Return Requested' ? 'bg-info text-dark' : 'bg-secondary' %>">
                                                                                <%= item.itemStatus %>
                                                                                    <% if (item.cancelReason) { %>
                                                                                        <br><small
                                                                                            class="fw-normal">Reason:
                                                                                            <%= item.cancelReason %>
                                                                                        </small>
                                                                                        <% } else if (item.returnReason)
                                                                                            { %>
                                                                                            <br><small
                                                                                                class="fw-normal">Reason:
                                                                                                <%= item.returnReason %>
                                                                                            </small>
                                                                                            <% } %>
                                                                            </span>
                                                                            <% if(item.adminReturnComment) { %>
                                                                                <small
                                                                                    class="d-block mt-1 text-muted"><strong>Admin
                                                                                        Note:</strong>
                                                                                    <%= item.adminReturnComment %>
                                                                                </small>
                                                                                <% } %>
                                                                                    <% if(item.itemStatus==='Return Requested'
                                                                                        ) { %>
                                                                                        <div class="mt-2">
                                                                                            <button
                                                                                                class="btn btn-sm btn-success me-1 py-0 px-2"
                                                                                                onclick="approveReturn('<%= order._id %>', '<%= item._id %>')"><i
                                                                                                    class="fas fa-check"></i>
                                                                                                Approve</button>
                                                                                            <button
                                                                                                class="btn btn-sm btn-danger py-0 px-2"
                                                                                                onclick="rejectReturn('<%= order._id %>', '<%= item._id %>')"><i
                                                                                                    class="fas fa-times"></i>
                                                                                                Reject</button>
                                                                                        </div>
                                                                                        <% } %>
                                                                                            <% } else if
                                                                                                (item.itemStatus==='Ordered'
                                                                                                &&
                                                                                                order.orderStatus==='Delivered'
                                                                                                ) { %>
                                                                                                <span
                                                                                                    class="badge bg-success p-1 px-2 mt-1">Delivered</span>
                                                                                                <% } %>
                                                                    </div>
                                                    </div>
                                                </td>
                                                <td>₹<%= item.price.toFixed(2) %>
                                                </td>
                                                <td>
                                                    <%= item.quantity %>
                                                </td>
                                                <td class="text-end">
                                                    <% if (item.itemStatus==='Cancelled' ) { %>
                                                        -₹<%= item.itemTotal.toFixed(2) %>
                                                            <% } else { %>
                                                                ₹<%= item.itemTotal.toFixed(2) %>
                                                                    <% } %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold">Subtotal</td>
                                            <td class="text-end">₹<%= subtotal.toFixed(2) %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" class="text-end">tax</td>
                                            <td class="text-end">₹<%= order.tax.toFixed(2) %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" class="text-end">Shipping Fee</td>
                                            <td class="text-end">₹<%= order.shippingFee.toFixed(2) %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold fs-5">Total</td>
                                            <td class="text-end fw-bold fs-5">₹<%= (subtotal + order.tax +
                                                    order.shippingFee).toFixed(2) %>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Customer, Shipping, Status -->
                <div class="col-lg-4">
                    <!-- Status Update -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Order Status</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label text-muted">Current Status</label>
                                <% let badgeClass='bg-secondary text-white' ; if (order.orderStatus==='Ordered' )
                                    badgeClass='bg-primary text-white' ; if (order.orderStatus==='Shipped' )
                                    badgeClass='bg-info text-white' ; if (order.orderStatus==='Out for Delivery' )
                                    badgeClass='bg-warning text-white' ; if (order.orderStatus==='Delivered' )
                                    badgeClass='bg-success text-white' ; if (order.orderStatus==='Cancelled' )
                                    badgeClass='bg-danger text-white' ; if (order.orderStatus==='Returned' )
                                    badgeClass='bg-dark text-white' ; %>
                                    <div><span class="badge <%= badgeClass %> fs-6 px-3 py-2">
                                            <%= order.orderStatus %>
                                        </span></div>
                                    <% if (order.orderStatus === 'Cancelled' && order.cancelReason) { %>
                                        <div class="mt-2 text-danger small"><strong>Cancellation Reason:</strong> <%= order.cancelReason %></div>
                                    <% } else if ((order.orderStatus === 'Return Requested' || order.orderStatus === 'Returned') && order.returnReason) { %>
                                        <div class="mt-2 text-info small"><strong>Return Reason:</strong> <%= order.returnReason %></div>
                                    <% } %>
                            </div>

                            <% if (order.orderStatus !=='Cancelled' && order.orderStatus !=='Returned' &&
                                order.orderStatus !=='Delivered' ) { %>
                                <form id="updateStatusForm">
                                    <div class="mb-3">
                                        <label for="statusSelect" class="form-label">Change Status</label>
                                        <select class="form-select" id="statusSelect" name="status">
                                            <!-- Logic: Disable options that represent a backward move or are the same as current -->
                                            <% 
                                                const priority = {
                                                    'Ordered': 1,
                                                    'Shipped': 2,
                                                    'Out for Delivery': 3,
                                                    'Delivered': 4,
                                                    'Cancelled': 5,
                                                    'Returned': 5
                                                };
                                                const currPriority = priority[order.orderStatus] || 0;
                                            %>
                                            <option value="Ordered" <%=order.orderStatus==='Ordered' ? 'selected' : '' %> <%= currPriority >= 1 ? 'disabled' : '' %>>Ordered</option>
                                            <option value="Shipped" <%=order.orderStatus==='Shipped' ? 'selected' : '' %> <%= currPriority >= 2 ? 'disabled' : '' %>>Shipped</option>
                                            <option value="Out for Delivery" <%=order.orderStatus==='Out for Delivery' ? 'selected' : '' %> <%= currPriority >= 3 ? 'disabled' : '' %>>Out for Delivery</option>
                                            <option value="Delivered" <%=order.orderStatus==='Delivered' ? 'selected' : '' %> <%= currPriority >= 4 ? 'disabled' : '' %>>Delivered</option>
                                            <option value="Cancelled" <%=order.orderStatus==='Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                            <option value="Returned" <%=order.orderStatus==='Returned' ? 'selected' : '' %>>Returned</option>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Update Status</button>
                                </form>
                                <% } else { %>
                                    <% if (order.orderStatus==='Delivered' ) { %>
                                        <div class="alert alert-success mb-0">
                                            <strong>Status Locked:</strong> Order is Delivered.
                                            <% if (order.deliveryDate) { %>
                                                <br><small>Delivered on <%= new
                                                        Date(order.deliveryDate).toLocaleDateString() %></small>
                                                <% } %>
                                        </div>
                                        <% } else { %>
                                            <div class="alert alert-secondary mb-0">
                                                Status updates are disabled for this order.
                                            </div>
                                            <% } %>
                                                <% } %>
                        </div>
                    </div>

                    <!-- Customer Info -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Customer Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <i class="fas fa-user text-secondary"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">
                                        <%= order.shippingAddress.full_name %>
                                    </h6>
                                    <small class="text-muted">Customer</small>
                                </div>
                            </div>
                            <div>
                                <a href="mailto:email@example.com" class="d-block text-decoration-none mb-1">
                                    <i class="fas fa-envelope me-2 text-muted"></i> [Email Placeholder]
                                </a>
                                <a href="tel:<%= order.shippingAddress.phone_number %>"
                                    class="d-block text-decoration-none">
                                    <i class="fas fa-phone me-2 text-muted"></i>
                                    <%= order.shippingAddress.phone_number %>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Shipping Info -->
                    <div class="card shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Shipping Address</h5>
                        </div>
                        <div class="card-body">
                            <address class="mb-0 text-muted">
                                <%= order.shippingAddress.full_address %><br>
                                    <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %><br>
                                            <%= order.shippingAddress.country %> - <%= order.shippingAddress.zip_code %>
                            </address>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script>
            document.getElementById('updateStatusForm')?.addEventListener('submit', async function (e) {
                e.preventDefault();

                const status = document.getElementById('statusSelect').value;

                let reason = '';
                if (status === 'Cancelled' || status === 'Returned') {
                    const { value: inputReason } = await Swal.fire({
                        title: `Reason for ${status}`,
                        input: 'text',
                        inputLabel: `Please provide a reason for marking this order as ${status}`,
                        inputPlaceholder: 'Enter reason here...',
                        showCancelButton: true,
                        inputValidator: (value) => {
                            if (!value) {
                                return 'You need to write something!'
                            }
                        }
                    });
                    
                    if (!inputReason) return; // User cancelled the prompt
                    reason = inputReason;
                }

                Swal.fire({
                    title: 'Update Status?',
                    text: `Are you sure you want to change the order status to "${status}"?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, update it!'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch('/admin/orders/update-status/<%= order._id %>', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ status, reason })
                            });

                            const data = await response.json();

                            if (data.success) {
                                Swal.fire({
                                    title: 'Updated!',
                                    text: data.message,
                                    icon: 'success',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    title: 'Error!',
                                    text: data.message || 'Update failed',
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                        } catch (err) {
                            console.error(err);
                            Swal.fire({
                                title: 'Error!',
                                text: 'Something went wrong',
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        }
                    }
                });
            });

            function approveReturn(orderId, itemId) {
                Swal.fire({
                    title: 'Approve Return?',
                    text: 'Optional comment/note:',
                    input: 'text',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, approve it',
                    showLoaderOnConfirm: true,
                    preConfirm: (comment) => {
                        return fetch(`/admin/orders/return-approve/${orderId}/${itemId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ comment })
                        })
                            .then(response => response.json())
                            .catch(error => Swal.showValidationMessage(`Request failed: ${error}`));
                    },
                    allowOutsideClick: () => !Swal.isLoading()
                }).then((result) => {
                    if (result.isConfirmed) {
                        if (result.value.success) {
                            Swal.fire('Approved!', result.value.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error!', result.value.message || 'Operation failed', 'error');
                        }
                    }
                });
            }

            function rejectReturn(orderId, itemId) {
                Swal.fire({
                    title: 'Reject Return?',
                    text: 'Please provide a reason for rejecting this return:',
                    input: 'text',
                    inputValidator: (value) => {
                        if (!value) {
                            return 'You need to write a reason to reject the return!';
                        }
                    },
                    showCancelButton: true,
                    confirmButtonText: 'Yes, reject it',
                    confirmButtonColor: '#d33',
                    showLoaderOnConfirm: true,
                    preConfirm: (comment) => {
                        return fetch(`/admin/orders/return-reject/${orderId}/${itemId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ comment })
                        })
                            .then(response => response.json())
                            .catch(error => Swal.showValidationMessage(`Request failed: ${error}`));
                    },
                    allowOutsideClick: () => !Swal.isLoading()
                }).then((result) => {
                    if (result.isConfirmed) {
                        if (result.value.success) {
                            Swal.fire('Rejected!', result.value.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error!', result.value.message || 'Operation failed', 'error');
                        }
                    }
                });
            }
        </script>

        <%- include('../../partials/admin/footer') %>