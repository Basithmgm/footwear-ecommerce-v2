<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/sidebar', { path: '/admin/products' }) %>

        <!-- Cropper.js CDN -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
        <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

        <style>
            .image-container {
                width: 300px;
                height: 300px;
                margin: 10px;
                overflow: hidden;
                border: 1px solid #ddd;
                display: flex;
                justify-content: center;
                align-items: center;
                background-color: #f8f9fa;
                position: relative;
            }

            .image-preview {
                max-width: 100%;
                max-height: 250px;
                object-fit: contain;
            }

            .preview-list {
                display: flex;
                flex-wrap: wrap;
                gap: 15px;
            }

            .remove-image {
                position: absolute;
                top: 5px;
                right: 5px;
                background: rgba(255, 0, 0, 0.7);
                color: white;
                border: none;
                border-radius: 50%;
                width: 25px;
                height: 25px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
            }
        </style>

        <main class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
                <h2 class="h3 mb-0">Add New Product</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/admin/products">Products</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Add New</li>
                    </ol>
                </nav>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <% if (typeof error !=='undefined' && error) { %>
                                <div class="alert alert-danger">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form action="/admin/products/add" method="POST" enctype="multipart/form-data"
                                        id="addProductForm">
                                        <div class="row">
                                            <!-- Left Column: Basic Info -->
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productName" class="form-label">Product Name *</label>
                                                    <input type="text" class="form-control" id="productName"
                                                        name="productName" required
                                                        value="<%= oldInput.productName || '' %>">
                                                </div>

                                                <!-- Category Selection Group -->
                                                <div class="mb-3 border p-3 rounded bg-light">
                                                    <h6 class="mb-3 text-secondary">Category Selection *</h6>

                                                    <!-- Hidden Input for Final Category ID to be submitted -->
                                                    <input type="hidden" id="finalCategory" name="category" required>

                                                    <!-- 1. Gender Selection -->
                                                    <div class="mb-3">
                                                        <label for="genderSelect"
                                                            class="form-label small text-muted">Gender</label>
                                                        <select class="form-select" id="genderSelect" required>
                                                            <option value="">Select Gender</option>
                                                            <option value="Men">Men</option>
                                                            <option value="Women">Women</option>
                                                            <option value="Kids">Kids</option>
                                                            <option value="Unisex">Unisex</option>
                                                        </select>
                                                    </div>

                                                    <!-- 2. Parent Category Selection -->
                                                    <div class="mb-3">
                                                        <label for="parentCategorySelect"
                                                            class="form-label small text-muted">Parent Category</label>
                                                        <select class="form-select" id="parentCategorySelect" disabled
                                                            required>
                                                            <option value="">Select Parent Category</option>
                                                            <!-- Populated via JS -->
                                                        </select>
                                                    </div>

                                                    <!-- 3. Child Category Selection (Optional) -->
                                                    <div class="mb-0">
                                                        <label for="childCategorySelect"
                                                            class="form-label small text-muted">Child Category
                                                            (Optional)</label>
                                                        <select class="form-select" id="childCategorySelect" disabled>
                                                            <option value="">Select Child Category</option>
                                                            <!-- Populated via JS -->
                                                        </select>
                                                        <div class="form-text" id="childCatHelp">Only shows if available
                                                            under selected parent.</div>
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="description" class="form-label">Description *</label>
                                                    <textarea class="form-control" id="description" name="description"
                                                        rows="4" required><%= oldInput.description || '' %></textarea>
                                                </div>
                                            </div>

                                            <!-- Right Column: Pricing & Stock -->
                                            <div class="col-md-6">
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label for="regularPrice" class="form-label">Regular Price
                                                            *</label>
                                                        <input type="number" class="form-control" id="regularPrice"
                                                            name="regularPrice" min="0" step="0.01" required
                                                            value="<%= oldInput.regularPrice || '' %>">
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label for="salePrice" class="form-label">Sale Price *</label>
                                                        <input type="number" class="form-control" id="salePrice"
                                                            name="salePrice" min="0" step="0.01" required
                                                            value="<%= oldInput.salePrice || '' %>">
                                                        <div class="form-text">Must be less than Regular Price</div>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label for="stock" class="form-label">Stock Quantity *</label>
                                                        <input type="number" class="form-control" id="stock"
                                                            name="stock" min="0" required
                                                            value="<%= oldInput.stock || '' %>">
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label for="status" class="form-label">Status</label>
                                                        <select class="form-select" id="status" name="status">
                                                            <option value="Available" <%=oldInput.status==='Available'
                                                                ? 'selected' : '' %>>Available</option>
                                                            <option value="Out of Stock"
                                                                <%=oldInput.status==='Out of Stock' ? 'selected' : '' %>
                                                                >Out of Stock</option>
                                                            <option value="Discontinued"
                                                                <%=oldInput.status==='Discontinued' ? 'selected' : '' %>
                                                                >Discontinued</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="mb-3 form-check">
                                                    <input type="checkbox" class="form-check-input" id="isFeatured"
                                                        name="isFeatured" <%=oldInput.isFeatured ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="isFeatured">Show on Homepage
                                                        (Featured)</label>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Image Upload Section -->
                                        <div class="mb-4">
                                            <label class="form-label">Product Images (Minimum 3 required) *</label>
                                            <input type="file" class="form-control" id="imageInput" accept="image/*"
                                                multiple>
                                            <div class="form-text">Select images to crop. Cropped images will be
                                                uploaded.</div>

                                            <!-- Hidden input to store cropped files when submitting (not directly usable, we use JS to construct FormData) -->
                                            <!-- We will handle submission via JS -->
                                        </div>

                                        <div class="preview-list" id="previewList"></div>

                                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                            <a href="/admin/products" class="btn btn-light me-md-2">Cancel</a>
                                            <button type="submit" class="btn btn-primary" id="submitBtn">Add
                                                Product</button>
                                        </div>
                                    </form>
                                    <!-- Hidden Data Storage -->
                                    <div id="categoryData" style="display:none;"><%- JSON.stringify(categories) %></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cropper Modal -->
            <div class="modal fade" id="cropperModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"
                data-bs-keyboard="false">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Crop Image</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-0" style="min-height: 400px; background: #000;">
                            <div class="img-container">
                                <img id="imageToCrop" src="" alt="Crop Preview"
                                    style="max-width: 100%; display: block;">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" id="cropBtn">Crop & Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    console.log("DOM Loaded. Initializing scripts...");

                    // ==========================================
                    // 1. CATEGORY SELECTION LOGIC (Independent)
                    // ==========================================

                    // Load Data
                    const dataElement = document.getElementById('categoryData');
                    let allCategories = [];
                    try {
                        if (dataElement) {
                            allCategories = JSON.parse(dataElement.textContent);
                            console.log("Categories loaded:", allCategories.length);
                        } else {
                            console.error("Category data element not found!");
                        }
                    } catch (e) {
                        console.error("Failed to parse category data:", e);
                    }

                    const genderSelect = document.getElementById('genderSelect');
                    const parentSelect = document.getElementById('parentCategorySelect');
                    const childSelect = document.getElementById('childCategorySelect');
                    const finalCategoryInput = document.getElementById('finalCategory');

                    if (genderSelect) {
                        genderSelect.addEventListener('change', function () {
                            const selectedGender = this.value;
                            console.log("Gender Changed:", selectedGender);

                            // Reset
                            parentSelect.innerHTML = '<option value="">Select Parent Category</option>';
                            childSelect.innerHTML = '<option value="">Select Child Category</option>';
                            finalCategoryInput.value = "";

                            if (selectedGender) {
                                const parents = allCategories.filter(cat =>
                                    cat.gender === selectedGender && (cat.level === 0 || !cat.parentCategory)
                                );

                                if (parents.length > 0) {
                                    parents.forEach(p => {
                                        const opt = document.createElement('option');
                                        opt.value = p._id;
                                        opt.textContent = p.name;
                                        parentSelect.appendChild(opt);
                                    });
                                } else {
                                    const opt = document.createElement('option');
                                    opt.textContent = "No categories found";
                                    parentSelect.appendChild(opt);
                                }
                                parentSelect.disabled = false; // UNLOCK
                            } else {
                                parentSelect.disabled = true;
                                childSelect.disabled = true;
                            }
                        });
                    }

                    if (parentSelect) {
                        parentSelect.addEventListener('change', function () {
                            const parentId = this.value;
                            console.log("Parent Changed:", parentId);

                            childSelect.innerHTML = '<option value="">Select Child Category</option>';

                            if (parentId) {
                                finalCategoryInput.value = parentId; // Set Valid Category

                                const children = allCategories.filter(cat => {
                                    if (!cat.parentCategory) return false;
                                    const catParentId = cat.parentCategory._id || cat.parentCategory;
                                    return catParentId.toString() === parentId;
                                });

                                if (children.length > 0) {
                                    children.forEach(c => {
                                        const opt = document.createElement('option');
                                        opt.value = c._id;
                                        opt.textContent = c.name;
                                        childSelect.appendChild(opt);
                                    });
                                } else {
                                    const opt = document.createElement('option');
                                    opt.textContent = "No subcategories";
                                    childSelect.appendChild(opt);
                                }
                                childSelect.disabled = false; // UNLOCK
                            } else {
                                finalCategoryInput.value = "";
                                childSelect.disabled = true;
                            }
                        });
                    }

                    if (childSelect) {
                        childSelect.addEventListener('change', function () {
                            if (this.value) {
                                finalCategoryInput.value = this.value;
                            } else {
                                finalCategoryInput.value = parentSelect.value;
                            }
                        });
                    }


                    // ==========================================
                    // 2. CROPPER LOGIC (Depends on Bootstrap)
                    // ==========================================
                    const imageInput = document.getElementById('imageInput');
                    const cropBtn = document.getElementById('cropBtn');
                    const form = document.getElementById('addProductForm');
                    const previewList = document.getElementById('previewList');
                    let cropper;
                    let croppedFiles = [];

                    // Helper to safely get Bootstrap Modal
                    const getModal = () => {
                        if (typeof bootstrap !== 'undefined') {
                            return new bootstrap.Modal(document.getElementById('cropperModal'));
                        } else {
                            console.error("Bootstrap is not loaded yet!");
                            alert("System is loading resources. Please try selecting image again in a moment.");
                            return null;
                        }
                    };

                    // Cropper Logic
                    // ... We can initialize logic but create modal instance lazily or check bootstrap existence

                    imageInput.addEventListener('change', function (e) {
                        const files = e.target.files;
                        if (files && files.length > 0) {
                            const file = files[0];
                            const reader = new FileReader();
                            reader.onload = function (e) {
                                const imageToCrop = document.getElementById('imageToCrop');
                                imageToCrop.src = e.target.result;

                                const modal = getModal();
                                if (modal) modal.show();
                            };
                            reader.readAsDataURL(file);
                            imageInput.value = '';
                        }
                    });

                    // Initialize Cropper when modal opens
                    const modalEl = document.getElementById('cropperModal');
                    modalEl.addEventListener('shown.bs.modal', function () {
                        const imageToCrop = document.getElementById('imageToCrop');
                        cropper = new Cropper(imageToCrop, {
                            aspectRatio: 1,
                            viewMode: 2,
                            autoCropArea: 1,
                        });
                    });

                    modalEl.addEventListener('hidden.bs.modal', function () {
                        if (cropper) {
                            cropper.destroy();
                            cropper = null;
                        }
                    });

                    // Crop Button
                    cropBtn.addEventListener('click', function () {
                        if (cropper) {
                            cropper.getCroppedCanvas({ width: 800, height: 800 }).toBlob((blob) => {
                                // Add blob to array
                                const fileName = `cropped-${Date.now()}.jpg`;
                                const file = new File([blob], fileName, { type: 'image/jpeg' });
                                croppedFiles.push(file);

                                renderPreviews();

                                // Hide modal
                                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                                if (modalInstance) modalInstance.hide();

                            }, 'image/jpeg');
                        }
                    });

                    // Render Previews function (Handling Reordering)
                    function renderPreviews() {
                        previewList.innerHTML = '';
                        croppedFiles.forEach((file, index) => {
                            const url = URL.createObjectURL(file);
                            const container = document.createElement('div');
                            container.className = 'image-container d-flex flex-column';

                            // Thumbnail
                            const img = document.createElement('img');
                            img.src = url;
                            img.className = 'image-preview flex-grow-1';
                            img.style.objectFit = 'contain';

                            // Controls
                            const controls = document.createElement('div');
                            controls.className = 'd-flex justify-content-between w-100 p-2 bg-light border-top';

                            // Left Arrow (Move Up/Left)
                            const leftBtn = document.createElement('button');
                            leftBtn.type = 'button';
                            leftBtn.className = 'btn btn-sm btn-outline-secondary';
                            leftBtn.innerHTML = '<i class="fas fa-arrow-left"></i>';
                            leftBtn.disabled = index === 0;
                            leftBtn.onclick = () => {
                                if (index > 0) {
                                    const temp = croppedFiles[index];
                                    croppedFiles[index] = croppedFiles[index - 1];
                                    croppedFiles[index - 1] = temp;
                                    renderPreviews();
                                }
                            };

                            // Index Indicator
                            const indexBadge = document.createElement('span');
                            indexBadge.className = 'badge bg-secondary align-self-center';
                            indexBadge.innerText = (index + 1);

                            // Right Arrow (Move Down/Right)
                            const rightBtn = document.createElement('button');
                            rightBtn.type = 'button';
                            rightBtn.className = 'btn btn-sm btn-outline-secondary';
                            rightBtn.innerHTML = '<i class="fas fa-arrow-right"></i>';
                            rightBtn.disabled = index === croppedFiles.length - 1;
                            rightBtn.onclick = () => {
                                if (index < croppedFiles.length - 1) {
                                    const temp = croppedFiles[index];
                                    croppedFiles[index] = croppedFiles[index + 1];
                                    croppedFiles[index + 1] = temp;
                                    renderPreviews();
                                }
                            };

                            controls.appendChild(leftBtn);
                            controls.appendChild(indexBadge);
                            controls.appendChild(rightBtn);

                            // Remove Button (Overlay)
                            const removeBtn = document.createElement('button');
                            removeBtn.innerHTML = '×';
                            removeBtn.className = 'remove-image';
                            removeBtn.type = 'button';
                            removeBtn.onclick = function () {
                                croppedFiles.splice(index, 1);
                                renderPreviews();
                            };

                            container.appendChild(removeBtn);
                            container.appendChild(img);
                            container.appendChild(controls);

                            previewList.appendChild(container);
                        });
                    }

                    // Form Submit
                    form.addEventListener('submit', function (e) {
                        e.preventDefault();
                        if (croppedFiles.length < 3) {
                            alert('Please add at least 3 images.');
                            return;
                        }
                        if (!finalCategoryInput.value) {
                            alert('Please select a valid category.');
                            return;
                        }

                        const formData = new FormData(form);
                        croppedFiles.forEach((file) => formData.append('productImages', file));

                        const submitBtn = document.getElementById('submitBtn');
                        const originalText = submitBtn.innerText;
                        submitBtn.disabled = true;
                        submitBtn.innerText = 'Uploading...';

                        fetch(form.action, { method: 'POST', body: formData })
                            .then(response => {
                                if (response.redirected) window.location.href = response.url;
                                else return response.text().then(html => {
                                    document.open(); document.write(html); document.close();
                                });
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                alert('An error occurred during upload.');
                                submitBtn.disabled = false;
                                submitBtn.innerText = originalText;
                            });
                    });
                });
            </script>