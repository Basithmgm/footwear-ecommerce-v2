<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Footwear Admin - Categories</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700" rel="stylesheet">
    <link rel="stylesheet" href="/css/custom.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <script src="/js/sweetalert2.all.min.js"></script>
    <style>
        body {
            background: #f8f9fa;
            font-family: 'Montserrat', sans-serif;
            margin: 0;
        }

        .admin-wrapper {
            min-height: 100vh;
            display: flex;
        }

        .admin-sidebar {
            width: 230px;
            background: #111;
            color: #fff;
            padding: 20px 15px;
        }

        .admin-sidebar .brand {
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            margin-bottom: 20px;
            font-size: 16px;
        }

        .admin-sidebar ul {
            list-style: none;
            padding-left: 0;
            margin-bottom: 0;
        }

        .admin-sidebar li {
            margin-bottom: 6px;
        }

        .admin-sidebar a {
            color: #ced4da;
            font-size: 14px;
            display: block;
            padding: 10px 8px;
            border-radius: 4px;
            text-decoration: none;
        }

        .admin-sidebar a:hover,
        .admin-sidebar a.active {
            background: #343a40;
            color: #fff;
        }

        .admin-content {
            flex: 1;
            padding: 20px;
        }

        .admin-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .admin-topbar-title {
            font-size: 20px;
            font-weight: 600;
        }

        .small-text {
            font-size: 12px;
            color: #6c757d;
        }

        .card-box {
            background: #fff;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            padding: 15px;
            margin-bottom: 15px;
        }

        /* Table Styles */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 10px;
            font-size: 14px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        th {
            font-weight: 600;
            color: #555;
            background: #f8f9fa;
        }

        .form-control {
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 13px;
        }

        .btn {
            padding: 6px 12px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
            text-decoration: none;
            display: inline-block;
        }

        .btn-dark {
            background: #333;
            color: white;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn-primary {
            background: #007bff;
            color: white;
        }

        .btn-outline {
            border: 1px solid #ddd;
            background: white;
            color: #333;
        }

        .pagination {
            display: flex;
            gap: 5px;
            margin-top: 15px;
            justify-content: flex-end;
        }

        .pagination a {
            padding: 5px 10px;
            border: 1px solid #ddd;
            text-decoration: none;
            color: #333;
            border-radius: 4px;
            font-size: 12px;
        }

        .pagination a.active {
            background: #333;
            color: white;
            border-color: #333;
        }
    </style>
</head>

<body>

    <div class="admin-wrapper">
        <%- include('../../partials/admin/sidebar', { path: '/admin/categories' }) %>

            <main class="admin-content">
                <div class="admin-topbar">
                    <div>
                        <div class="admin-topbar-title">Category Management</div>
                        <div class="small-text">Add, edit, or delete product categories.</div>
                    </div>
                    <a href="/admin/categories/add" class="btn btn-primary">+ Add New Category</a>
                </div>

                <!-- Filters -->
                <div class="card-box filters">
                    <form action="/admin/categories" method="GET"
                        style="display: flex; gap: 10px; align-items: center;">
                        <div style="flex: 1; max-width: 300px;">
                            <input type="text" name="search" class="form-control" placeholder="Search categories..."
                                value="<%= search %>">
                        </div>
                        <button type="submit" class="btn btn-dark">Search</button>
                        <% if (search) { %>
                            <a href="/admin/categories" class="btn btn-outline">Clear</a>
                            <% } %>
                    </form>
                </div>

                <!-- Categories table -->
                <div class="card-box">
                    <div class="d-flex justify-content-between align-items-center mb-2"
                        style="display:flex; justify-content:space-between; margin-bottom:10px;">
                        <h5 style="margin:0; font-size: 16px;">Category List</h5>
                        <span class="small-text">Total Categories: <%= totalCategories %></span>
                    </div>

                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Created At</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (categories.length> 0) { %>
                                    <% categories.forEach(category=> { %>
                                        <tr>
                                            <td>
                                                <div style="font-weight: 500;">
                                                    <%= category.name %>
                                                </div>
                                            </td>
                                            <td>
                                                <%= category.description || '-' %>
                                            </td>
                                            <td>
                                                <%= new Date(category.createdAt).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <a href="/admin/categories/edit/<%= category._id %>"
                                                    class="btn btn-outline" style="margin-right: 5px;">Edit</a>
                                                <button type="button" onclick="confirmDelete('<%= category._id %>')"
                                                    class="btn btn-danger">Delete</button>
                                                <!-- Hidden Form -->
                                                <form id="delete-form-<%= category._id %>"
                                                    action="/admin/categories/delete/<%= category._id %>" method="POST"
                                                    style="display:none;"></form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="4" style="text-align: center; padding: 20px;">No
                                                        categories found.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages> 1) { %>
                        <div class="pagination">
                            <% if (currentPage> 1) { %>
                                <a
                                    href="/admin/categories?page=<%= currentPage - 1 %>&search=<%= search %>">Previous</a>
                                <% } %>

                                    <% for(let i=1; i <=totalPages; i++) { %>
                                        <a href="/admin/categories?page=<%= i %>&search=<%= search %>"
                                            class="<%= currentPage === i ? 'active' : '' %>">
                                            <%= i %>
                                        </a>
                                        <% } %>

                                            <% if (currentPage < totalPages) { %>
                                                <a
                                                    href="/admin/categories?page=<%= currentPage + 1 %>&search=<%= search %>">Next</a>
                                                <% } %>
                        </div>
                        <% } %>

                </div>
            </main>
    </div>

    <script>
        // Check for server-side success message
        <% if (locals.success) { %>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '<%= success %>',
                timer: 2000,
                showConfirmButton: false
            });
        <% } %>

        // Check for server-side error message
        <% if (locals.error) { %>
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: '<%= error %>',
            });
        <% } %>

            function confirmDelete(id) {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "This category will be moved to trash.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('delete-form-' + id).submit();
                    }
                })
            }
    </script>
</body>

</html>