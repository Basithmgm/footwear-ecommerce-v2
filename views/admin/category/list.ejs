<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/sidebar', { path: '/admin/categories' }) %>

        <main class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
                <h2 class="h3 mb-0 text-gray-800">Category Management</h2>
                <a href="/admin/categories/add" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Add Parent Category
                </a>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
                <% } %>
                    <% if (success) { %>
                        <div class="alert alert-success">
                            <%= success %>
                        </div>
                        <% } %>

                            <div class="card shadow-sm">
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="ps-4">Gender</th>
                                                    <th>Group Name</th>
                                                    <th>Level</th>
                                                    <th>Parent Category</th>
                                                    <th class="text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (categories.length> 0) { %>
                                                    <% categories.forEach(cat=> { %>
                                                        <tr>
                                                            <td class="ps-4">
                                                                <% let badgeColor='#6c757d' ; let textColor='white' ; if
                                                                    (cat.gender==='Women' ) { badgeColor='#FF8DA1' ; }
                                                                    else if (cat.gender==='Men' ) { badgeColor='#01A6EA'
                                                                    ; } else if (cat.gender==='Unisex' ) {
                                                                    badgeColor='#A649A4' ; } else if
                                                                    (cat.gender==='Kids' ) { badgeColor='#FFCC10' ;
                                                                    textColor='black' ; } %>
                                                                    <span class="badge"
                                                                        style="background-color: <%= badgeColor %>; color: <%= textColor %>;">
                                                                        <%= cat.gender %>
                                                                    </span>
                                                            </td>
                                                            <td>
                                                                <% if(cat.level> 0) { %>
                                                                    <span class="text-muted"
                                                                        style="margin-left: <%= cat.level * 20 %>px;">↳
                                                                    </span>
                                                                    <% } %>
                                                                        <strong>
                                                                            <%= cat.name %>
                                                                        </strong>
                                                            </td>
                                                            <td>
                                                                <% if (cat.level===0) { %>
                                                                    <span class="badge bg-secondary">Main</span>
                                                                    <% } else if (cat.level===1) { %>
                                                                        <span class="badge bg-info">Sub</span>
                                                                        <% } else { %>
                                                                            <span
                                                                                class="badge bg-light text-dark">Child</span>
                                                                            <% } %>
                                                            </td>
                                                            <td>
                                                                <% if (cat.level===0) { %>
                                                                    <a href="/admin/categories/add?parent_id=<%= cat._id %>&page=<%= currentPage %>"
                                                                        class="btn btn-sm btn-light border"
                                                                        style="font-size: 0.75rem;">
                                                                        <i class="fas fa-plus me-1"></i> Add Subcategory
                                                                    </a>
                                                                    <% } else { %>
                                                                        <%= cat.parentCategory ? cat.parentCategory.name
                                                                            : '-' %>
                                                                            <% } %>
                                                            </td>
                                                            <td class="text-center">
                                                                <div
                                                                    class="d-flex justify-content-center align-items-center gap-3">

                                                                    <!-- Toggle Form with Label -->
                                                                    <div class="d-flex align-items-center">
                                                                        <span class="me-2 text-muted fw-bold"
                                                                            style="font-size: 0.85rem;">Block</span>
                                                                        <form
                                                                            action="/admin/categories/toggle-block/<%= cat._id %>"
                                                                            method="POST" class="d-inline m-0">
                                                                            <div
                                                                                class="form-check form-switch m-0 d-flex align-items-center">
                                                                                <input class="form-check-input"
                                                                                    type="checkbox" role="switch"
                                                                                    onchange="this.form.submit()"
                                                                                    <%=!cat.isBlocked ? 'checked' : ''
                                                                                    %>
                                                                                title="<%= cat.isBlocked ? 'Unblock'
                                                                                    : 'Block' %>"
                                                                                    style="cursor: pointer; width: 3em;
                                                                                    height: 1.5em;">
                                                                            </div>
                                                                        </form>
                                                                    </div>

                                                                    <div class="btn-group">
                                                                        <a href="/admin/categories/edit/<%= cat._id %>?page=<%= currentPage %>"
                                                                            class="btn btn-sm btn-outline-secondary">
                                                                            <i class="fas fa-edit"></i>
                                                                        </a>
                                                                        <form
                                                                            action="/admin/categories/delete/<%= cat._id %>"
                                                                            method="POST" class="d-inline"
                                                                            onsubmit="return confirm('Are you sure? This will delete the category.');">
                                                                            <button type="submit"
                                                                                class="btn btn-sm btn-outline-danger ms-1">
                                                                                <i class="fas fa-trash"></i>
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="6" class="text-center py-4 text-muted">
                                                                        No categories found.</td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Pagination -->
                                    <% if (locals.totalPages> 1) { %>
                                        <div class="d-flex justify-content-center py-3 border-top">
                                            <nav aria-label="Page navigation">
                                                <ul class="pagination mb-0">
                                                    <!-- Previous -->
                                                    <li class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
                                                        <a class="page-link" href="?page=<%= currentPage - 1 %>"
                                                            aria-label="Previous">
                                                            <span aria-hidden="true">&laquo;</span>
                                                        </a>
                                                    </li>

                                                    <!-- Page Numbers -->
                                                    <% for(let i=1; i <=totalPages; i++) { %>
                                                        <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                                            <a class="page-link" href="?page=<%= i %>">
                                                                <%= i %>
                                                            </a>
                                                        </li>
                                                        <% } %>

                                                            <!-- Next -->
                                                            <li
                                                                class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
                                                                <a class="page-link" href="?page=<%= currentPage + 1 %>"
                                                                    aria-label="Next">
                                                                    <span aria-hidden="true">&raquo;</span>
                                                                </a>
                                                            </li>
                                                </ul>
                                            </nav>
                                        </div>
                                        <% } %>

                                </div>
                            </div>
        </main>

        <%- include('../../partials/admin/footer') %>