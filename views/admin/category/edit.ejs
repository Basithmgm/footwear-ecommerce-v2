<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/sidebar', { path: '/admin/categories' }) %>

        <main class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
                <h2 class="h3 mb-0">Edit Category</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/admin/categories">Categories</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit <%= category.name %>
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">


                            <form id="editCategoryForm" action="/admin/categories/edit/<%= category._id %>"
                                method="POST">
                                <input type="hidden" name="redirectPage"
                                    value="<%= typeof redirectPage !== 'undefined' ? redirectPage : 1 %>">
                                <!-- Category Name -->
                                <div class="mb-3">
                                    <label for="name" class="form-label">Category Name *</label>
                                    <input type="text" class="form-control" id="name" name="name"
                                        value="<%= category.name %>" required>
                                </div>

                                <!-- Parent Category Selection -->
                                <div class="mb-3">
                                    <label for="parentCategory" class="form-label">Parent Category
                                        (Locked)</label>
                                    <select class="form-select bg-light" id="parentCategory" name="parentCategory"
                                        disabled>
                                        <option value="">None (Main Category)</option>
                                        <% parentCategories.forEach(parent=> { %>
                                            <option value="<%= parent._id %>" data-gender="<%= parent.gender %>"
                                                <%=(category.parentCategory &&
                                                category.parentCategory.toString()===parent._id.toString()) ? 'selected'
                                                : '' %>>
                                                <%= parent.gender %> - <%= parent.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                    <div class="form-text text-muted">Parent category cannot be changed after
                                        creation.</div>
                                </div>

                                <!-- Gender Selection -->
                                <div class="mb-3">
                                    <label for="gender" class="form-label">Gender *</label>
                                    <select class="form-select" id="gender" name="gender" required>
                                        <option value="Kids" <%=category.gender==='Kids' ? 'selected' : '' %>
                                            >Kids</option>
                                        <option value="Men" <%=category.gender==='Men' ? 'selected' : '' %>>Men
                                        </option>
                                        <option value="Unisex" <%=category.gender==='Unisex' ? 'selected' : '' %>>Unisex
                                        </option>
                                        <option value="Women" <%=category.gender==='Women' ? 'selected' : '' %>
                                            >Women</option>
                                    </select>
                                </div>

                                <!-- Description -->
                                <div class="mb-3">
                                    <label for="description" class="form-label">Description</label>
                                    <textarea class="form-control" id="description" name="description"
                                        rows="3"><%= category.description || '' %></textarea>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="/admin/categories" class="btn btn-light me-md-2">Cancel</a>
                                    <button type="button" id="updateCategoryBtn" class="btn btn-primary">Update
                                        Category</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script src="/js/sweetalert2.all.min.js"></script>
        <script>
            function updateGenderField() {
                const parentSelect = document.getElementById('parentCategory');
                const genderSelect = document.getElementById('gender');

                const selectedOption = parentSelect.options[parentSelect.selectedIndex];
                const parentGender = selectedOption.getAttribute('data-gender');

                if (parentGender) {
                    genderSelect.value = parentGender;
                    // Visual feedback only for edit page, or disable interaction
                    genderSelect.style.pointerEvents = 'none';
                    genderSelect.classList.add('bg-light');
                } else {
                    genderSelect.style.pointerEvents = 'auto';
                    genderSelect.classList.remove('bg-light');
                }
            }
            // Run on load to set initial state
            document.addEventListener('DOMContentLoaded', updateGenderField);

            document.addEventListener('DOMContentLoaded', function () {
                const updateBtn = document.getElementById('updateCategoryBtn');
                const form = document.getElementById('editCategoryForm');

                // Check for Server-Side Error and Show SweetAlert
                <% if (error) { %>
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: '<%= error %>',
                        confirmButtonColor: '#d33'
                    });
                <% } %>

                if (updateBtn && form) {
                    updateBtn.addEventListener('click', function (e) {

                        e.preventDefault();
                        Swal.fire({
                            title: 'Update Category?',
                            text: "Are you sure you want to save these changes?",
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: 'Yes, update it!',
                            cancelButtonText: 'No'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                form.submit();
                            }
                        });
                    });
                }
            });
        </script>

        <%- include('../../partials/admin/footer') %>