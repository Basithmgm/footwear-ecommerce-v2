<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/sidebar', { path: '/admin/categories' }) %>

        <main class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
                <h2 class="h3 mb-0">Edit Category</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/admin/categories">Categories</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit <%= category.name %>
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <% if (error) { %>
                                <div class="alert alert-danger">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form action="/admin/categories/edit/<%= category._id %>" method="POST">
                                        <input type="hidden" name="redirectPage"
                                            value="<%= typeof redirectPage !== 'undefined' ? redirectPage : 1 %>">
                                        <!-- Category Name -->
                                        <div class="mb-3">
                                            <label for="name" class="form-label">Category Name *</label>
                                            <input type="text" class="form-control" id="name" name="name"
                                                value="<%= category.name %>" required>
                                        </div>

                                        <!-- Parent Category Selection -->
                                        <div class="mb-3">
                                            <label for="parentCategory" class="form-label">Parent Category</label>
                                            <select class="form-select" id="parentCategory" name="parentCategory"
                                                onchange="updateGenderField()">
                                                <option value="">None (Main Category)</option>
                                                <% parentCategories.forEach(parent=> { %>
                                                    <option value="<%= parent._id %>" data-gender="<%= parent.gender %>"
                                                        <%=(category.parentCategory &&
                                                        category.parentCategory.toString()===parent._id.toString())
                                                        ? 'selected' : '' %>>
                                                        <%= parent.gender %> - <%= parent.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>

                                        <!-- Gender Selection -->
                                        <div class="mb-3">
                                            <label for="gender" class="form-label">Gender *</label>
                                            <select class="form-select" id="gender" name="gender" required>
                                                <option value="Kids" <%=category.gender==='Kids' ? 'selected' : '' %>
                                                    >Kids</option>
                                                <option value="Men" <%=category.gender==='Men' ? 'selected' : '' %>>Men
                                                </option>
                                                <option value="Unisex" <%=category.gender==='Unisex' ? 'selected' : ''
                                                    %>>Unisex</option>
                                                <option value="Women" <%=category.gender==='Women' ? 'selected' : '' %>
                                                    >Women</option>
                                            </select>
                                        </div>

                                        <!-- Blocking -->
                                        <div class="mb-3 form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="isBlocked"
                                                name="isBlocked" <%=category.isBlocked ? 'checked' : '' %>>
                                            <label class="form-check-label" for="isBlocked">Block Category (Hides
                                                products in Shop)</label>
                                        </div>

                                        <!-- Description -->
                                        <div class="mb-3">
                                            <label for="description" class="form-label">Description</label>
                                            <textarea class="form-control" id="description" name="description"
                                                rows="3"><%= category.description || '' %></textarea>
                                        </div>

                                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                            <a href="/admin/categories" class="btn btn-light me-md-2">Cancel</a>
                                            <button type="submit" class="btn btn-primary">Update Category</button>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script>
            function updateGenderField() {
                const parentSelect = document.getElementById('parentCategory');
                const genderSelect = document.getElementById('gender');

                const selectedOption = parentSelect.options[parentSelect.selectedIndex];
                const parentGender = selectedOption.getAttribute('data-gender');

                if (parentGender) {
                    genderSelect.value = parentGender;
                    // Visual feedback only for edit page, or disable interaction
                    genderSelect.style.pointerEvents = 'none';
                    genderSelect.classList.add('bg-light');
                } else {
                    genderSelect.style.pointerEvents = 'auto';
                    genderSelect.classList.remove('bg-light');
                }
            }
            // Run on load to set initial state
            document.addEventListener('DOMContentLoaded', updateGenderField);
        </script>

        <%- include('../../partials/admin/footer') %>