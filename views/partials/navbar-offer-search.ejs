<nav class="colorlib-nav" role="navigation">
  <div class="top-menu">
    <div class="container">
      <!-- Row 1: logo left, search right -->
      <div class="row align-items-center">
        <!-- Logo -->
        <div class="col-sm-4 col-md-4">
          <div id="colorlib-logo">
            <a href="/">Footwear</a>
          </div>
        </div>

        <!-- Search on the right -->
        <div class="col-sm-8 col-md-8">
          <div class="header-top-right">
            <form action="/search" method="get" class="search-wrap">
              <div class="form-group">
                <input type="search" name="q" class="form-control search search-narrow" placeholder="Search" />
                <button aria-label="submit-search" class="btn btn-primary submit-search text-center" type="submit">
                  <i class="icon-search"></i>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Row 2: menu left, cart right (same row) -->
      <div class="row align-items-center nav-second-row">
        <div class="col-sm-8 col-md-8">
          <div class="menu-1 menu-left">
            <ul>
              <li class="has-dropdown <%= (locals.activeMenu === 'home') ? 'active' : '' %>">
                <a href="/">Home</a>
                <ul class="dropdown">
                  <li><a href="/shop">Shop All Products</a></li>
                </ul>
              </li>
              <li class="has-dropdown <%= (locals.activeMenu === 'men') ? 'active' : '' %>">
                <a href="/men">Men</a>
                <ul class="dropdown">
                  <% if (locals.navCategories && locals.navCategories.men && locals.navCategories.men.length> 0) { %>
                    <% locals.navCategories.men.forEach(cat=> { %>
                      <!-- Show only parent categories level 0 or main ones if you wish, currently showing all active men categories -->
                      <% if (!cat.parentCategory) { %>
                        <li><a href="/men?category=<%= cat._id %>">
                            <%= cat.name %>
                          </a></li>
                        <% } %>
                          <% }); %>
                            <li><a href="/men">View All Men</a></li>
                            <% } else { %>
                              <li><a href="/men">Shop Men</a></li>
                              <% } %>
                </ul>
              </li>
              <li class="has-dropdown <%= (locals.activeMenu === 'women') ? 'active' : '' %>">
                <a href="/women">Women</a>
                <ul class="dropdown">
                  <% if (locals.navCategories && locals.navCategories.women && locals.navCategories.women.length> 0) {
                    %>
                    <% locals.navCategories.women.forEach(cat=> { %>
                      <% if (!cat.parentCategory) { %>
                        <li><a href="/women?category=<%= cat._id %>">
                            <%= cat.name %>
                          </a></li>
                        <% } %>
                          <% }); %>
                            <li><a href="/women">View All Women</a></li>
                            <% } else { %>
                              <li><a href="/women">Shop Women</a></li>
                              <% } %>
                </ul>
              </li>
              <li><a href="/about">About</a></li>
              <li><a href="/contact">Contact</a></li>

              <% if (locals.user) { %>
                <li class="has-dropdown <%= (locals.activeMenu === 'profile') ? 'active' : '' %>">
                  <a href="/profile">My Profile</a>
                  <ul class="dropdown">
                    <li><a href="/profile">View Profile</a></li>
                    <li>
                      <form action="/logout" method="POST" style="margin: 0">
                        <button type="submit" class="fw-navbar-btn">
                          Logout
                        </button>
                      </form>
                    </li>
                  </ul>
                </li>
                <% } else { %>
                  <li class="auth-item"><a href="/login" class="auth-link">Sign In</a></li>
                  <% } %>
            </ul>
          </div>
        </div>

        <div class="col-sm-4 col-md-4">
          <div class="cart cart-right">
            <a href="/cart"> <i class="icon-shopping-cart"></i> Cart [0] </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Offer banner with Owl Carousel -->
  <!-- Offer banner with Marquee -->
  <% if (locals.activeBanners && activeBanners.length> 0) { %>
    <div class="marquee-container"
      style="background-color: <%= locals.bannerBgColor %>; color: <%= locals.bannerTextColor %>;">
      <div class="marquee-content" style="animation-duration: <%= locals.bannerSpeed %>s;">
        <% activeBanners.forEach((banner, index)=> { %>
          <% if (index> 0) { %>
            <span class="separator" style="color: <%= locals.bannerTextColor %>;">|</span>
            <% } %>
              <a href="<%= banner.link %>" style="color: <%= locals.bannerTextColor %>;">
                <%= banner.title %>
              </a>
              <% }) %>

                <span class="separator" style="color: <%= locals.bannerTextColor %>;">|</span>

                <% activeBanners.forEach((banner, index)=> { %>
                  <% if (index> 0) { %>
                    <span class="separator" style="color: <%= locals.bannerTextColor %>;">|</span>
                    <% } %>
                      <a href="<%= banner.link %>" style="color: <%= locals.bannerTextColor %>;">
                        <%= banner.title %>
                      </a>
                      <% }) %>
      </div>
    </div>
    <% } %>
</nav>