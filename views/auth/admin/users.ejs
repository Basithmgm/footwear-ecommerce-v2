<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/sidebar', { path: '/admin/users' }) %>

        <main class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
                <div>
                    <h2 class="h3 mb-0 text-gray-800">User Management</h2>
                    <div class="text-muted small">Manage users and access control.</div>
                </div>
            </div>

            <!-- Filters -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form action="/admin/users" method="GET" class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <input type="text" name="search" class="form-control" placeholder="Search by name or email"
                                value="<%= search %>">
                        </div>
                        <div class="col-md-auto">
                            <button type="submit" class="btn btn-dark">Search</button>
                            <% if (search) { %>
                                <a href="/admin/users" class="btn btn-outline-secondary">Clear</a>
                                <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Users table -->
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 font-weight-bold text-dark">User List</h5>
                    <span class="badge bg-secondary">Total Users: <%= totalUsers %></span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Full Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Verified</th>
                                    <th>Status</th>
                                    <th>Role</th>
                                    <th>Joined Date</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (users.length> 0) { %>
                                    <% users.forEach(user=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold">
                                                    <%= user.full_name %>
                                                </div>
                                            </td>
                                            <td>
                                                <%= user.email %>
                                            </td>
                                            <td>
                                                <%= user.phone_number || '-' %>
                                            </td>
                                            <td>
                                                <% if (user.isVerified) { %>
                                                    <span class="text-success"><i
                                                            class="fas fa-check-circle"></i></span>
                                                    <% } else { %>
                                                        <span class="text-warning"><i
                                                                class="fas fa-times-circle"></i></span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <% if (user.status==='Blocked' ) { %>
                                                    <span
                                                        class="badge bg-danger bg-opacity-10 text-danger">Blocked</span>
                                                    <% } else { %>
                                                        <span
                                                            class="badge bg-success bg-opacity-10 text-success">Active</span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <%= user.role_id ? user.role_id.role_name : 'N/A' %>
                                            </td>
                                            <td>
                                                <%= new Date(user.created_at).toLocaleDateString() %>
                                            </td>
                                            <td class="text-center">
                                                <% if (user.status==='Blocked' ) { %>
                                                    <form action="/admin/users/unblock/<%= user._id %>" method="POST"
                                                        style="display:inline-block;" class="action-form">
                                                        <input type="hidden" name="userName"
                                                            value="<%= user.full_name %>">
                                                        <button type="button" class="btn btn-sm btn-success action-btn"
                                                            data-action="unblock">
                                                            <i class="fas fa-unlock me-1"></i>Unblock
                                                        </button>
                                                    </form>
                                                    <% } else { %>
                                                        <form action="/admin/users/block/<%= user._id %>" method="POST"
                                                            style="display:inline-block;" class="action-form">
                                                            <input type="hidden" name="userName"
                                                                value="<%= user.full_name %>">
                                                            <button type="button"
                                                                class="btn btn-sm btn-danger action-btn"
                                                                data-action="block">
                                                                <i class="fas fa-ban me-1"></i>Block
                                                            </button>
                                                        </form>
                                                        <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8" class="text-center py-5 text-muted">No users found.
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages> 1) { %>
                        <div class="d-flex justify-content-end p-3 border-top">
                            <nav aria-label="Page navigation">
                                <ul class="pagination mb-0">
                                    <li class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search %>"
                                            aria-label="Previous">
                                            <span aria-hidden="true">&laquo;</span>
                                        </a>
                                    </li>

                                    <% for(let i=1; i <=totalPages; i++) { %>
                                        <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                            <a class="page-link" href="/admin/users?page=<%= i %>&search=<%= search %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                            <li class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
                                                <a class="page-link"
                                                    href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search %>"
                                                    aria-label="Next">
                                                    <span aria-hidden="true">&raquo;</span>
                                                </a>
                                            </li>
                                </ul>
                            </nav>
                        </div>
                        <% } %>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>


            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    console.log("Admin Users Page Script Loaded");

                    // Handle Block/Unblock clicks using Event Delegation
                    const table = document.querySelector('.table');
                    if (table) {
                        table.addEventListener('click', function (e) {
                            // Find the closest button if the icon was clicked
                            const btn = e.target.closest('.action-btn');
                            if (!btn) return;

                            e.preventDefault();
                            console.log('Action button clicked');

                            const action = btn.dataset.action; // 'block' or 'unblock'
                            const form = btn.closest('form');
                            const nameInput = form.querySelector('input[name="userName"]');
                            const userName = nameInput ? nameInput.value : 'User';

                            const isBlock = action === 'block';
                            const confirmText = isBlock ? 'Yes, Block!' : 'Yes, Unblock!';
                            const btnColor = isBlock ? '#d33' : '#28a745';

                            Swal.fire({
                                title: 'Are you sure?',
                                text: `Do you really want to ${action} ${userName}?`,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: btnColor,
                                cancelButtonColor: '#6c757d',
                                confirmButtonText: 'Yes',
                                cancelButtonText: 'No'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    console.log('Confirmed. Submitting form...');
                                    form.submit();
                                }
                            });
                        });
                    }

                    // Show server-side messages
                    <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length > 0) { %>
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: '<%= successMessage %>',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    <% } %>

                    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '<%= error %>',
                        });
                    <% } %>
                });
            </script>