<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/sidebar', { path: '/admin/users' }) %>

        <main class="admin-content">
            <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
                <div>
                    <h2 class="h3 mb-0 text-gray-800">User Management</h2>
                    <div class="text-muted small">Manage users and access control.</div>
                </div>
            </div>

            <!-- Filters -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form action="/admin/users" method="GET" class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <input type="text" name="search" class="form-control" placeholder="Search by name or email"
                                value="<%= search %>">
                        </div>
                        <div class="col-md-auto">
                            <button type="submit" class="btn btn-dark">Search</button>
                            <% if (search) { %>
                                <a href="/admin/users" class="btn btn-outline-secondary">Clear</a>
                                <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Users table -->
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 font-weight-bold text-dark">User List</h5>
                    <span class="badge bg-secondary">Total Users: <%= totalUsers %></span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Full Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Verified</th>
                                    <th>Status</th>
                                    <th>Role</th>
                                    <th>Joined Date</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (users.length> 0) { %>
                                    <% users.forEach(user=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold">
                                                    <%= user.full_name %>
                                                </div>
                                            </td>
                                            <td>
                                                <%= user.email %>
                                            </td>
                                            <td>
                                                <%= user.phone_number || '-' %>
                                            </td>
                                            <td>
                                                <% if (user.isVerified) { %>
                                                    <span class="text-success"><i
                                                            class="fas fa-check-circle"></i></span>
                                                    <% } else { %>
                                                        <span class="text-warning"><i
                                                                class="fas fa-times-circle"></i></span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <% if (user.status==='Blocked' ) { %>
                                                    <span
                                                        class="badge bg-danger bg-opacity-10 text-danger">Blocked</span>
                                                    <% } else { %>
                                                        <span
                                                            class="badge bg-success bg-opacity-10 text-success">Active</span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <%= user.role_id ? user.role_id.role_name : 'N/A' %>
                                            </td>
                                            <td>
                                                <%= new Date(user.created_at).toLocaleDateString() %>
                                            </td>
                                            <td class="text-center">
                                                <% if (user.status==='Blocked' ) { %>
                                                    <button type="button" onclick="confirmUnblock('<%= user._id %>')"
                                                        class="btn btn-sm btn-success">
                                                        <i class="fas fa-unlock me-1"></i>Unblock
                                                    </button>
                                                    <form id="unblock-form-<%= user._id %>"
                                                        action="/admin/users/unblock/<%= user._id %>" method="POST"
                                                        style="display:none;"></form>
                                                    <% } else { %>
                                                        <button type="button" onclick="confirmBlock('<%= user._id %>')"
                                                            class="btn btn-sm btn-danger">
                                                            <i class="fas fa-ban me-1"></i>Block
                                                        </button>
                                                        <form id="block-form-<%= user._id %>"
                                                            action="/admin/users/block/<%= user._id %>" method="POST"
                                                            style="display:none;"></form>
                                                        <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8" class="text-center py-5 text-muted">No users found.
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages> 1) { %>
                        <div class="d-flex justify-content-end p-3 border-top">
                            <nav aria-label="Page navigation">
                                <ul class="pagination mb-0">
                                    <li class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search %>"
                                            aria-label="Previous">
                                            <span aria-hidden="true">&laquo;</span>
                                        </a>
                                    </li>

                                    <% for(let i=1; i <=totalPages; i++) { %>
                                        <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                            <a class="page-link" href="/admin/users?page=<%= i %>&search=<%= search %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                            <li class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
                                                <a class="page-link"
                                                    href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search %>"
                                                    aria-label="Next">
                                                    <span aria-hidden="true">&raquo;</span>
                                                </a>
                                            </li>
                                </ul>
                            </nav>
                        </div>
                        <% } %>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>

            <script>
    // Check for server-side success message
    <% if (locals.successMessage?.length > 0) { %>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '<%= successMessage %>',
                        timer: 2000,
                        showConfirmButton: false
                    });
    <% } %>

    // Check for server-side error message
    <% if (locals.error?.length > 0) { %>
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: '<%= error %>',
                    });
    <% } %>

                    function confirmBlock(userId) {
                        Swal.fire({
                            title: 'Are you sure?',
                            text: "You are about to block this user. They will not be able to login.",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#d33',
                            cancelButtonColor: '#3085d6',
                            confirmButtonText: 'Yes, Block!',
                            cancelButtonText: 'Cancel'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                document.getElementById('block-form-' + userId).submit();
                            }
                        })
                    }

                function confirmUnblock(userId) {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You are about to unblock this user.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#28a745',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, Unblock!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById('unblock-form-' + userId).submit();
                        }
                    })
                }
            </script>