<!DOCTYPE html>
<html lang="en">

<head>
  <title>Edit Profile - Footwear</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/sweetalert2.min.css">
  <script src="/js/sweetalert2.all.min.js"></script>
  <style>
    /* Reusing styles from display.ejs + form styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f7f7f7;
      min-height: 100vh;
      padding: 20px;
    }

    .navbar {
      background: white;
      padding: 15px 30px;
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .navbar-brand {
      font-weight: bold;
      font-size: 20px;
      text-decoration: none;
      color: #333;
    }

    .navbar-menu a {
      text-decoration: none;
      color: #666;
      margin-left: 20px;
      font-weight: 500;
    }

    .profile-container {
      max-width: 600px;
      margin: 0 auto;
    }

    .profile-card {
      background-color: white;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      padding: 40px;
    }

    .card-title {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 30px;
      color: #333;
      text-align: center;
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 8px;
      color: #333;
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"] {
      width: 100%;
      padding: 12px;
      font-size: 14px;
      border: 1px solid #ddd;
      border-radius: 8px;
      outline: none;
      transition: border-color 0.3s;
    }

    input:focus {
      border-color: #444;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .btn-container {
      margin-top: 30px;
      display: flex;
      gap: 15px;
    }

    .btn {
      flex: 1;
      padding: 12px;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 0.3s;
    }

    .btn-primary {
      background-color: #444;
      color: white;
    }

    .btn-primary:hover {
      background-color: #333;
    }

    .btn-secondary {
      background-color: #ebebeb;
      color: #333;
    }

    .btn-secondary:hover {
      background-color: #ddd;
    }

    .alert-note {
      font-size: 13px;
      color: #856404;
      background-color: #fff3cd;
      border: 1px solid #ffeeba;
      padding: 10px;
      border-radius: 6px;
      margin-top: 5px;
    }
  </style>
</head>

<body>
  <nav class="navbar">
    <a href="/" class="navbar-brand">Footwear</a>
    <div class="navbar-menu">
      <a href="/">Home</a>
      <a href="/profile">My Profile</a>
    </div>
  </nav>

  <div class="profile-container">
    <% if (locals.error) { %>
      <script>
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: '<%= error %>',
          confirmButtonColor: '#444'
        });
      </script>
      <% } %>

        <div class="profile-card">
          <h3 class="card-title">Edit Profile</h3>

          <form action="/profile/update" method="POST" enctype="multipart/form-data">

            <div style="text-align: center; margin-bottom: 20px;">
              <img src="<%= user.image || '/images/default-avatar.jpg' %>" alt="Current Avatar"
                style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #eee; margin-bottom: 10px;"
                onerror="this.src='/images/default-avatar.jpg'">
              <br>
              <label style="cursor: pointer; color: #007bff; font-size: 14px;">
                Change Photo
                <input type="file" name="profileImage" accept="image/*" style="display: none;"
                  onchange="document.getElementById('file-name').textContent = this.files[0].name">
              </label>
              <div id="file-name" style="font-size: 13px; color: #666;"></div>
            </div>

            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" value="<%= user.full_name %>" required>
            </div>

            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" value="<%= user.email %>" required>
              <div class="alert-note">
                Note: Changing your email will require verification via OTP sent to the new address.
              </div>
            </div>

            <div class="form-group">
              <label>Phone Number</label>
              <input type="tel" name="phone" value="<%= user.phone_number || '' %>" placeholder="Enter phone number">
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #eee;">
            <!-- Address section removed from here as addresses are managed separately now -->
            <p style="text-align:center; color:#666; font-size:13px;">To manage addresses, please go back to your
              profile dashboard.</p>

            <div class="btn-container">
              <a href="/profile" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
          </form>
        </div>
  </div>
</body>

</html>