<!DOCTYPE html>
<html lang="en">

<head>
  <title>Edit Profile - Footwear</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <!-- Standard CSS Includes -->
  <link rel="stylesheet" href="/css/animate.css" />
  <link rel="stylesheet" href="/css/icomoon.css" />
  <link rel="stylesheet" href="/css/ionicons.min.css" />
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/magnific-popup.css" />
  <link rel="stylesheet" href="/css/flexslider.css" />
  <link rel="stylesheet" href="/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/css/bootstrap-datepicker.css" />
  <link rel="stylesheet" href="/fonts/flaticon/font/flaticon.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/sweetalert2.min.css" />
  <script src="/js/sweetalert2.all.min.js"></script>

  <style>
    html,
    body {
      margin: 0;
      padding: 0;
      background-color: #f7f7f7;
      overflow-x: hidden !important;
      width: 100%;
    }

    #page {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      background-color: transparent !important;
      overflow-x: hidden !important;
      position: relative;
      display: block !important;
    }

    .profile-container {
      max-width: 600px;
      margin: 50px auto !important;
      /* Symmetric top and bottom spacing */
      padding: 0 15px;
    }

    .profile-card {
      background-color: white !important;
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08) !important;
      padding: 40px;
      border: 1px solid #eee !important;
    }

    .card-title {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 30px;
      color: #333;
      text-align: center;
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 8px;
      color: #333;
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"] {
      width: 100%;
      padding: 12px;
      font-size: 14px;
      border: 1px solid #ddd;
      border-radius: 8px;
      outline: none;
      transition: border-color 0.3s;
    }

    input:focus {
      border-color: #444;
    }

    .btn-container {
      margin-top: 30px;
      display: flex;
      gap: 15px;
    }

    .btn {
      flex: 1;
      padding: 12px;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 0.3s;
    }

    .btn-primary {
      background-color: #444;
      color: white;
    }

    .btn-primary:hover {
      background-color: #333;
    }

    .btn-secondary {
      background-color: #ebebeb;
      color: #333;
    }

    .btn-secondary:hover {
      background-color: #ddd;
    }

    .alert-note {
      font-size: 13px;
      color: #856404;
      background-color: #fff3cd;
      border: 1px solid #ffeeba;
      padding: 10px;
      border-radius: 6px;
      margin-top: 5px;
    }
  </style>
</head>

<body>
  <div class="colorlib-loader"></div>
  <div id="page">
    <%- include('../partials/navbar-offer-search') %>

      <div class="profile-container">
        <% if (locals.error) { %>
          <script>
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: '<%= error %>',
              confirmButtonColor: '#444'
            });
          </script>
          <% } %>

            <div class="profile-card">
              <h3 class="card-title">Edit Profile</h3>

              <form id="profileForm" action="/profile/update" method="POST" enctype="multipart/form-data">

                <div style="text-align: center; margin-bottom: 20px;">
                  <img src="<%= user.image || '/images/default-avatar.jpg' %>" alt="Current Avatar"
                    style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #eee; margin-bottom: 10px;"
                    onerror="this.src='/images/default-avatar.jpg'">
                  <br>
                  <label style="cursor: pointer; color: #007bff; font-size: 14px;">
                    Change Photo
                    <input type="file" name="profileImage" id="profileImageInput" accept="image/*"
                      style="display: none;">
                  </label>
                  <div id="file-name" style="font-size: 13px; color: #666;"></div>
                </div>

                <div class="form-group">
                  <label>Full Name</label>
                  <input type="text" name="name" value="<%= user.full_name %>" required>
                </div>

                <div class="form-group">
                  <label>Email Address</label>
                  <input type="email" name="email" value="<%= user.email %>" required>
                  <div class="alert-note">
                    Note: Changing your email will require verification via OTP sent to the new address.
                  </div>
                </div>

                <div class="form-group">
                  <label>Phone Number</label>
                  <input type="tel" name="phone" value="<%= user.phone_number || '' %>"
                    placeholder="Enter phone number">
                </div>

                <hr style="margin: 30px 0; border: 0; border-top: 1px solid #eee;">
                <!-- Address section removed from here as addresses are managed separately now -->
                <p style="text-align:center; color:#666; font-size:13px;">To manage addresses, please go back to your
                  profile dashboard.</p>

                <div class="btn-container">
                  <a href="/profile" class="btn btn-secondary">Cancel</a>
                  <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
              </form>
            </div>
      </div>
      <%- include('../partials/footer') %>
  </div>
  <script>
    document.getElementById('profileForm').addEventListener('submit', function (e) {
      const phoneInput = document.querySelector('input[name="phone"]');
      const emailInput = document.querySelector('input[name="email"]');
      const phoneValue = phoneInput.value.trim();
      const emailValue = emailInput.value.trim();

      // Email Validation
      // Simple regex to check for @ symbol and basic structure
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailValue)) {
        e.preventDefault();
        Swal.fire({
          icon: 'warning',
          title: 'Invalid Email',
          text: 'Please enter valid email address',
          confirmButtonColor: '#444'
        });
        return;
      }

      // Phone Validation
      // Check if phone has value, then check if it contains only digits
      if (phoneValue) {
        const phoneRegex = /^\d+$/;
        if (!phoneRegex.test(phoneValue)) {
          e.preventDefault();
          Swal.fire({
            icon: 'warning',
            title: 'Invalid Phone Number',
            text: 'Please enter valid phone number or mobile number',
            confirmButtonColor: '#444'
          });
          return;
        }
      }

      // File Input Change Handler (CSP Fix)
      const fileInput = document.getElementById('profileImageInput');
      if (fileInput) {
        fileInput.addEventListener('change', function () {
          if (this.files && this.files[0]) {
            document.getElementById('file-name').textContent = this.files[0].name;
          }
        });
      }
    });
  </script>
  <!-- Standard JS Includes -->
  <script src="/js/jquery.min.js"></script>
  <script src="/js/popper.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/jquery.easing.1.3.js"></script>
  <script src="/js/jquery.waypoints.min.js"></script>
  <script src="/js/jquery.flexslider-min.js"></script>
  <script src="/js/owl.carousel.min.js"></script>
  <script src="/js/jquery.magnific-popup.min.js"></script>
  <script src="/js/magnific-popup-options.js"></script>
  <script src="/js/bootstrap-datepicker.js"></script>
  <script src="/js/jquery.stellar.min.js"></script>
  <script src="/js/main.js"></script>
</body>

</html>