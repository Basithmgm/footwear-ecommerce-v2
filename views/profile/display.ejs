<!DOCTYPE html>
<html lang="en">

<head>
  <title>My Profile - Footwear</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <!-- Standard CSS Includes -->
  <link rel="stylesheet" href="/css/animate.css" />
  <link rel="stylesheet" href="/css/icomoon.css" />
  <link rel="stylesheet" href="/css/ionicons.min.css" />
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/magnific-popup.css" />
  <link rel="stylesheet" href="/css/flexslider.css" />
  <link rel="stylesheet" href="/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/css/bootstrap-datepicker.css" />
  <link rel="stylesheet" href="/fonts/flaticon/font/flaticon.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/sweetalert2.min.css">
  <script src="/js/sweetalert2.all.min.js"></script>
  <style>
    html,
    body {
      margin: 0;
      padding: 0;
      background-color: #f7f7f7;
      overflow-x: hidden !important;
      width: 100%;
    }

    #page {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      background-color: transparent !important;
      overflow-x: hidden !important;
      position: relative;
    }

    .profile-container {
      max-width: 800px;
      margin: 50px auto !important;
      /* Symmetric top and bottom spacing */
      padding: 0 15px;
    }

    .profile-card {
      background-color: white !important;
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08) !important;
      padding: 40px;
      display: flex;
      flex-direction: column;
      gap: 30px;
      border: 1px solid #eee !important;
    }

    .profile-header {
      display: flex;
      align-items: center;
      gap: 20px;
      border-bottom: 1px solid #eee;
      padding-bottom: 20px;
    }

    .profile-img {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #eee;
    }

    .profile-info h2 {
      font-size: 24px;
      color: #333;
      margin-bottom: 5px;
    }

    .profile-info p {
      color: #666;
      font-size: 14px;
    }

    .verified-badge {
      color: #28a745;
      font-size: 14px;
      margin-left: 5px;
    }

    .section-title {
      font-size: 18px;
      font-weight: 600;
      color: #333;
      margin-bottom: 15px;
    }

    .info-group {
      margin-bottom: 20px;
    }

    .info-label {
      font-size: 12px;
      text-transform: uppercase;
      color: #888;
      letter-spacing: 0.5px;
      margin-bottom: 5px;
    }

    .info-value {
      font-size: 16px;
      color: #333;
      font-weight: 500;
    }

    .address-card {
      background: #f9f9f9;
      padding: 15px;
      border-radius: 8px;
      border: 1px solid #eee;
    }

    .action-buttons {
      display: flex;
      gap: 15px;
      margin-top: 10px;
    }

    .btn {
      padding: 10px 20px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      transition: all 0.2s;
      border: none;
      cursor: pointer;
    }

    .btn-primary {
      background: #444;
      color: white;
    }

    .btn-primary:hover {
      background: #333;
    }

    .btn-outline {
      background: transparent;
      border: 1px solid #ddd;
      color: #666;
    }

    .btn-outline:hover {
      border-color: #444;
      color: #444;
    }

    .empty-state {
      color: #999;
      font-style: italic;
    }
  </style>
</head>

<body>
  <!-- Simple Navbar -->
  <div class="colorlib-loader"></div>
  <div id="page">
    <%- include('../partials/navbar-offer-search') %>

      <div class="profile-container">
        <% if (locals.success) { %>
          <script>
            Swal.fire({
              icon: 'success',
              title: 'Success',
              text: '<%= success %>',
              confirmButtonColor: '#444'
            });
          </script>
          <% } %>

            <% if (locals.error) { %>
              <script>
                Swal.fire({
                  icon: 'error',
                  title: 'Profile Error',
                  text: '<%= error %>',
                  confirmButtonColor: '#444'
                });
              </script>
              <% } %>

                <div class="profile-card">
                  <% if (locals.user) { %>
                    <div class="profile-header">
                      <img src="<%= user.image || '/images/default-avatar.jpg' %>" alt="Profile" class="profile-img"
                        id="userProfileImage">
                      <div class="profile-info">
                        <h2>
                          <%= user.full_name %>
                        </h2>
                        <p>
                          <%= user.email %>
                            <% if (user.isVerified) { %>
                              <span class="verified-badge" title="Verified">✓ Verified</span>
                              <% } else { %>
                                <span style="color:orange; font-size:12px; margin-left:5px;">(Unverified)</span>
                                <% } %>
                        </p>
                        <p style="color: #666; font-size: 14px; margin-top:5px;">
                          Phone Number: <%= user.phone_number || 'No phone added' %>
                        </p>
                        <p style="font-size:12px; color:#999; margin-top:5px;">Member since <%= new
                            Date(user.created_at).toLocaleDateString() %>
                        </p>
                      </div>
                    </div>

                    <div class="profile-body">
                      <div
                        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <div class="section-title" style="margin: 0;">Address Book</div>
                        <div>
                          <a href="/orders" class="btn btn-primary"
                            style="text-decoration:none; cursor:pointer; font-size: 13px; padding: 5px 15px; margin-right: 10px;">My
                            Orders</a>
                          <a href="/profile/address/add" class="btn btn-outline"
                            style="text-decoration:none; cursor:pointer; font-size: 13px; padding: 5px 15px;">+ Add
                            New</a>
                        </div>
                      </div>

                      <% if (user.addresses?.length> 0) { %>
                        <div style="display: grid; gap: 20px;">
                          <% user.addresses.forEach(addr=> { %>
                            <div class="address-card">
                              <div style="display: flex; align-items: center; margin-bottom: 5px;">
                                <p style="font-weight: 600; font-size: 16px; margin: 0;">
                                  <%= addr.full_address %>
                                </p>
                                <% if (addr.is_default) { %>
                                  <span
                                    style="background-color: #28a745; color: white; font-size: 10px; padding: 2px 6px; border-radius: 10px; margin-left: 10px; font-weight: bold;">Default</span>
                                  <% } %>
                              </div>
                              <p style="color: #666; font-size: 14px; margin-bottom: 15px;">
                                <%= addr.city %>, <%= addr.state %>
                                    <%= addr.zip_code %>, <%= addr.country %>
                                        <br>
                                        <% if (addr.phone_number) { %>
                                          Phone: <%= addr.phone_number %>
                                            <% } %>
                              </p>

                              <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                                <% if (!addr.is_default) { %>
                                  <form id="set-default-form-<%= addr._id %>"
                                    action="/profile/address/set-default/<%= addr._id %>" method="POST"
                                    style="display:inline; margin:0;">
                                    <button type="button" class="set-default-btn" data-id="<%= addr._id %>"
                                      style="background:none; border:none; color:#28a745; font-size:13px; cursor:pointer; padding:0; text-decoration: underline;">Set
                                      as Default</button>
                                  </form>
                                  <% } %>

                                    <a href="/profile/address/edit/<%= addr._id %>"
                                      style="font-size: 13px; color: #007bff; text-decoration: none;">Edit</a>

                                    <form id="delete-address-form-<%= addr._id %>"
                                      action="/profile/address/delete/<%= addr._id %>" method="POST"
                                      style="display:inline; margin:0;">
                                      <button type="button" class="delete-address-btn" data-id="<%= addr._id %>"
                                        style="background:none; border:none; color:#dc3545; font-size:13px; cursor:pointer; padding:0;">Delete</button>
                                    </form>
                              </div>
                            </div>
                            <% }) %>
                        </div>
                        <% } else { %>
                          <p class="empty-state">No addresses added yet.</p>
                          <% } %>

                      <% if (typeof referralOffer !== 'undefined' && referralOffer && referralOffer.isActive) { %>
                      <div style="margin-top: 30px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <div class="section-title" style="margin: 0;">Refer & Earn</div>
                      </div>
                      <div class="address-card">
                        <p style="font-weight: 600; font-size: 16px; margin: 0; margin-bottom: 10px;">Share this code with your friends to earn rewards!</p>
                        <div style="display: flex; gap: 10px; align-items: center;">
                          <input type="text" readonly value="<%= user.referralCode || 'Not Available' %>" id="myReferralCode" class="form-control" style="max-width: 200px;">
                          <button class="btn btn-outline" type="button" onclick="copyReferralCode()" style="padding: 8px 15px;">Copy Code</button>
                        </div>
                        <div style="margin-top: 15px;">
                          <p style="color: #666; font-size: 14px; margin-bottom: 5px;">Or share this link:</p>
                          <div style="display: flex; gap: 10px; align-items: center;">
                            <input type="text" readonly value="http://localhost:3000/signup?ref=<%= user.referralCode || '' %>" id="myReferralLink" class="form-control" style="font-size: 13px;">
                            <button class="btn btn-outline" type="button" onclick="copyReferralLink()" style="padding: 8px 15px;">Copy Link</button>
                          </div>
                        </div>
                      </div>
                      <% } %>

                    </div>

                    <div class="action-buttons">
                      <a href="/profile/edit" class="btn btn-primary">Edit Profile</a>
                      <a href="/profile/change-password" class="btn btn-outline">Change Password</a>
                    </div>
                    <% } else { %>
                      <div style="text-align: center; padding: 50px;">
                        <h3>User not found.</h3>
                        <p>There was a problem loading your profile data.</p>
                        <p>Please try logging out and logging back in.</p>
                        <% if (locals.error) { %>
                          <p style="color:red; margin-top:10px;">Error details: <%= error %>
                          </p>
                          <% } %>
                            <form action="/logout" method="POST" style="margin-top:20px;">
                              <button type="submit" class="btn btn-primary">Logout & Retry</button>
                            </form>
                      </div>
                      <% } %>
                </div>
      </div>
      <%- include('../partials/footer') %>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // 1. Image Error Fallback
      const profileImg = document.getElementById('userProfileImage');
      if (profileImg) {
        profileImg.addEventListener('error', function () {
          this.src = '/images/default-avatar.jpg';
        });
      }

      // 2. Delete Address Confirmation
      document.querySelectorAll('.delete-address-btn').forEach(button => {
        button.addEventListener('click', function () {
          const addressId = this.getAttribute('data-id');
          Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
          }).then((result) => {
            if (result.isConfirmed) {
              document.getElementById('delete-address-form-' + addressId).submit();
            }
          });
        });
      });

      // 3. Set Default Address Confirmation (Optional, but good for consistency)
      document.querySelectorAll('.set-default-btn').forEach(button => {
        button.addEventListener('click', function () {
          const addressId = this.getAttribute('data-id');
          document.getElementById('set-default-form-' + addressId).submit();
        });
      });
    });

    function copyReferralCode() {
      const codeInput = document.getElementById("myReferralCode");
      codeInput.select();
      document.execCommand("copy");
      Swal.fire({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        icon: 'success',
        title: 'Referral code copied!'
      });
    }

    function copyReferralLink() {
      const linkInput = document.getElementById("myReferralLink");
      linkInput.select();
      document.execCommand("copy");
      Swal.fire({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        icon: 'success',
        title: 'Referral link copied!'
      });
    }
  </script>
  <!-- Standard JS Includes -->
  <script src="/js/jquery.min.js"></script>
  <script src="/js/popper.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/jquery.easing.1.3.js"></script>
  <script src="/js/jquery.waypoints.min.js"></script>
  <script src="/js/jquery.flexslider-min.js"></script>
  <script src="/js/owl.carousel.min.js"></script>
  <script src="/js/jquery.magnific-popup.min.js"></script>
  <script src="/js/magnific-popup-options.js"></script>
  <script src="/js/bootstrap-datepicker.js"></script>
  <script src="/js/jquery.stellar.min.js"></script>
  <script src="/js/main.js"></script>

</body>

</html>