<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= pageTitle %> - Footwear
    </title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="/css/animate.css">
    <link rel="stylesheet" href="/css/icomoon.css">
    <link rel="stylesheet" href="/css/ionicons.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom.css">
</head>

<body>
    <div class="colorlib-loader"></div>
    <div id="page">
        <%- include('../../partials/navbar-offer-search') %>

            <div class="breadcrumbs">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <p class="bread"><span><a href="/">Home</a></span> / <span><a href="/orders">My
                                        Orders</a></span> / <span>Details</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="colorlib-product">
                <div class="container">
                    <div class="row">
                        <div class="col-md-12 mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <h3>Order #<%= order._id.toString().slice(-6).toUpperCase() %>
                                </h3>
                                <div class="btn-group">
                                    <% if (order.orderStatus !=='Cancelled' ) { %>
                                        <a href="/orders/invoice/<%= order._id %>"
                                            class="btn btn-outline-secondary btn-sm" target="_blank">Download
                                            Invoice</a>
                                        <% } %>

                                            <a href="/orders" class="btn btn-outline-secondary btn-sm">Back to
                                                Orders</a>
                                </div>
                            </div>
                            <p class="text-muted">Placed on <%= new Date(order.orderedDate).toLocaleDateString() %>
                            </p>
                        </div>

                        <div class="col-lg-8">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-white font-weight-bold">Items</div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <% order.items.forEach(item=> { %>
                                            <tr>
                                                <td style="width: 70px;">
                                                    <img src="<%= item.image || '/images/product-placeholder.jpg' %>"
                                                        alt="<%= item.productName %>" class="img-fluid rounded"
                                                        style="width: 60px; height: auto;">
                                                </td>
                                                <td>
                                                    <h6 class="mb-1"><a href="/product/<%= item.productId._id %>">
                                                            <%= item.productName %>
                                                        </a></h6>
                                                    <small class="text-muted d-block mb-1">
                                                        Size: <%= item.size %> | Color: <%= item.variantId %>
                                                    </small>

                                                    <!-- Display Item Level Status if applicable -->
                                                    <% if (item.itemStatus && item.itemStatus !=='Ordered' ) { %>
                                                        <span
                                                            class="badge p-1 px-2 mt-1
                                                                    <%= item.itemStatus === 'Cancelled' || item.itemStatus === 'Return Rejected' ? 'badge-danger' : 
                                                                        item.itemStatus === 'Returned' ? 'badge-warning' : 
                                                                        item.itemStatus === 'Return Requested' ? 'badge-info' : 'badge-secondary' %>">
                                                            <%= item.itemStatus %>
                                                        </span>
                                                        <% if (item.adminReturnComment) { %>
                                                            <small class="d-block mt-1 text-muted"><strong>Admin
                                                                    Note:</strong>
                                                                <%= item.adminReturnComment %>
                                                            </small>
                                                            <% } %>
                                                                <% } else if (item.itemStatus==='Ordered' &&
                                                                    order.orderStatus==='Delivered' ) { %>
                                                                    <span
                                                                        class="badge badge-success p-1 px-2 mt-1">Delivered</span>
                                                                    <% } %>
                                                </td>
                                                <td class="align-middle text-center">x<%= item.quantity %>
                                                </td>
                                                <td class="align-middle text-right font-weight-bold">₹<%=
                                                        item.itemTotal.toFixed(2) %>

                                                        <!-- Item Level Action Buttons -->
                                                        <div class="mt-2">
                                                            <% if (order.orderStatus !=='Cancelled' && order.orderStatus
                                                                !=='Delivered' && order.orderStatus !=='Returned' &&
                                                                order.orderStatus !=='Return Requested' &&
                                                                order.orderStatus !=='Return Rejected' ) { %>
                                                                <% if (!item.itemStatus || ['Ordered', 'Shipped'
                                                                    , 'Out for Delivery' ].includes(item.itemStatus)) {
                                                                    %>
                                                                    <button
                                                                        onclick="cancelOrderItem('<%= order._id %>', '<%= item._id %>')"
                                                                        class="btn btn-outline-danger btn-sm py-1 px-2"
                                                                        style="font-size: 0.75rem;">Cancel Item</button>
                                                                    <% } %>
                                                                        <% } %>

                                                                            <% if (order.orderStatus==='Delivered' ) {
                                                                                %>
                                                                                <% if (!item.itemStatus ||
                                                                                    ['Ordered', 'Shipped'
                                                                                    , 'Out for Delivery' , 'Delivered'
                                                                                    ].includes(item.itemStatus)) { %>
                                                                                    <button
                                                                                        onclick="returnOrderItem('<%= order._id %>', '<%= item._id %>')"
                                                                                        class="btn btn-outline-warning btn-sm py-1 px-2"
                                                                                        style="font-size: 0.75rem;">Return
                                                                                        Item</button>
                                                                                    <% } %>
                                                                                        <% } %>
                                                        </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                </tbody>
                                                </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-white font-weight-bold">Order Summary</div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal</span>
                                        <span>₹<%= (order.totalAmount - order.tax - order.shippingFee).toFixed(2) %>
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Shipping</span>
                                        <span>₹<%= order.shippingFee.toFixed(2) %></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tax</span>
                                        <span>₹<%= order.tax.toFixed(2) %></span>
                                    </div>
                                    <hr>
                                    <div class="d-flex justify-content-between mb-3">
                                        <span class="font-weight-bold">Total</span>
                                        <span class="font-weight-bold h5 mb-0">₹<%= order.totalAmount.toFixed(2) %>
                                        </span>
                                    </div>

                                    <div class="mb-3">
                                        <span class="badge p-2 w-100 
                                        <%= order.orderStatus === 'Delivered' ? 'badge-success' : 
                                           order.orderStatus === 'Cancelled' ? 'badge-danger' : 
                                           'badge-info' %>">
                                            Status: <%= order.orderStatus %>
                                        </span>
                                    </div>
                                    <div>
                                        <strong class="d-block mb-1">Payment Method</strong>
                                        <span class="text-muted">
                                            <%= order.paymentMethod %> (<%= order.paymentStatus %>)
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-white font-weight-bold">Shipping Address</div>
                                <div class="card-body">
                                    <strong class="d-block">
                                        <%= order.shippingAddress.full_name %>
                                    </strong>
                                    <address class="mb-0 text-muted small">
                                        <%= order.shippingAddress.full_address %><br>
                                            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %><br>
                                                    <%= order.shippingAddress.country %> - <%=
                                                            order.shippingAddress.zip_code %><br>
                                                            Phone: <%= order.shippingAddress.phone_number %>
                                    </address>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('../../partials/footer') %>
    </div>

    <div class="gototop js-top"><a href="#" class="js-gotop"><i class="ion-ios-arrow-up"></i></a></div>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.easing.1.3.js"></script>
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.flexslider-min.js"></script>
    <script src="/js/owl.carousel.min.js"></script>
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <script src="/js/magnific-popup-options.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="/css/sweetalert2.min.css">

    <script>
        function cancelOrderItem(orderId, itemId) {
            Swal.fire({
                title: 'Cancel Item?',
                text: "Please provide a reason for cancelling this specific item:",
                input: 'text',
                inputAttributes: {
                    autocapitalize: 'off'
                },
                showCancelButton: true,
                confirmButtonText: 'Yes, cancel it!',
                showLoaderOnConfirm: true,
                preConfirm: (reason) => {
                    return fetch(`/orders/cancel-item/${orderId}/${itemId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason })
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(response.statusText)
                            }
                            return response.json()
                        })
                        .catch(error => {
                            Swal.showValidationMessage(
                                `Request failed: ${error}`
                            )
                        })
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed) {
                    if (result.value.success) {
                        Swal.fire(
                            'Cancelled!',
                            result.value.message,
                            'success'
                        ).then(() => location.reload());
                    } else {
                        Swal.fire(
                            'Error!',
                            result.value.message,
                            'error'
                        );
                    }
                }
            })
        }

        function returnOrderItem(orderId, itemId) {
            Swal.fire({
                title: 'Return Item?',
                text: "Please provide a reason for returning this specific item (Mandatory):",
                input: 'text',
                inputValidator: (value) => {
                    if (!value) {
                        return 'You need to write a reason!'
                    }
                },
                showCancelButton: true,
                confirmButtonText: 'Yes, return it!',
                showLoaderOnConfirm: true,
                preConfirm: (reason) => {
                    return fetch(`/orders/return-item/${orderId}/${itemId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason })
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(response.statusText)
                            }
                            return response.json()
                        })
                        .catch(error => {
                            Swal.showValidationMessage(
                                `Request failed: ${error}`
                            )
                        })
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed) {
                    if (result.value.success) {
                        Swal.fire(
                            'Returned!',
                            result.value.message,
                            'success'
                        ).then(() => location.reload());
                    } else {
                        Swal.fire(
                            'Error!',
                            result.value.message,
                            'error'
                        );
                    }
                }
            })
        }
    </script>
</body>

</html>