<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= pageTitle %> - Footwear
    </title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="/css/animate.css">
    <link rel="stylesheet" href="/css/icomoon.css">
    <link rel="stylesheet" href="/css/ionicons.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom.css">
</head>

<body>
    <div class="colorlib-loader"></div>
    <div id="page">
        <%- include('../../partials/navbar-offer-search') %>

            <div class="breadcrumbs">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <p class="bread"><span><a href="/">Home</a></span> / <span><a href="/orders">My
                                        Orders</a></span> / <span>Details</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="colorlib-product">
                <div class="container">
                    <div class="row">
                        <div class="col-md-12 mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <h3>Order #<%= order._id.toString().slice(-6).toUpperCase() %>
                                </h3>
                                <div class="btn-group">
                                    <% if (order.orderStatus !=='Cancelled' ) { %>
                                        <a href="/orders/invoice/<%= order._id %>"
                                            class="btn btn-outline-secondary btn-sm" target="_blank">Download
                                            Invoice</a>
                                        <% } %>

                                            <% if (order.orderStatus==='Ordered' ) { %>
                                                <button onclick="cancelOrder('<%= order._id %>')"
                                                    class="btn btn-outline-danger btn-sm">Cancel Order</button>
                                                <% } %>

                                                    <% if (order.orderStatus==='Delivered' ) { %>
                                                        <button onclick="returnOrder('<%= order._id %>')"
                                                            class="btn btn-outline-warning btn-sm">Return Order</button>
                                                        <% } %>

                                                            <a href="/orders"
                                                                class="btn btn-outline-secondary btn-sm">Back to
                                                                Orders</a>
                                </div>
                            </div>
                            <p class="text-muted">Placed on <%= new Date(order.orderedDate).toLocaleDateString() %>
                            </p>
                        </div>

                        <div class="col-lg-8">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-white font-weight-bold">Items</div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table mb-0">
                                            <tbody>
                                                <% order.items.forEach(item=> { %>
                                                    <tr>
                                                        <td style="width: 100px;">
                                                            <img src="<%= item.image || '/images/product-placeholder.jpg' %>"
                                                                alt="<%= item.productName %>" class="img-fluid rounded">
                                                        </td>
                                                        <td>
                                                            <h6 class="mb-1"><a
                                                                    href="/product/<%= item.productId._id %>">
                                                                    <%= item.productName %>
                                                                </a></h6>
                                                            <small class="text-muted">
                                                                Size: <%= item.size %> | Color: <%= item.variantId %>
                                                            </small>
                                                        </td>
                                                        <td>x<%= item.quantity %>
                                                        </td>
                                                        <td class="text-right font-weight-bold">₹<%=
                                                                item.price.toFixed(2) %>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-white font-weight-bold">Order Summary</div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal</span>
                                        <span>₹<%= (order.totalAmount - order.tax - order.shippingFee).toFixed(2) %>
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Shipping</span>
                                        <span>₹<%= order.shippingFee.toFixed(2) %></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tax</span>
                                        <span>₹<%= order.tax.toFixed(2) %></span>
                                    </div>
                                    <hr>
                                    <div class="d-flex justify-content-between mb-3">
                                        <span class="font-weight-bold">Total</span>
                                        <span class="font-weight-bold h5 mb-0">₹<%= order.totalAmount.toFixed(2) %>
                                        </span>
                                    </div>

                                    <div class="mb-3">
                                        <span class="badge p-2 w-100 
                                        <%= order.orderStatus === 'Delivered' ? 'badge-success' : 
                                           order.orderStatus === 'Cancelled' ? 'badge-danger' : 
                                           'badge-info' %>">
                                            Status: <%= order.orderStatus %>
                                        </span>
                                    </div>
                                    <div>
                                        <strong class="d-block mb-1">Payment Method</strong>
                                        <span class="text-muted">
                                            <%= order.paymentMethod %> (<%= order.paymentStatus %>)
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-white font-weight-bold">Shipping Address</div>
                                <div class="card-body">
                                    <strong class="d-block">
                                        <%= order.shippingAddress.full_name %>
                                    </strong>
                                    <address class="mb-0 text-muted small">
                                        <%= order.shippingAddress.full_address %><br>
                                            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %><br>
                                                    <%= order.shippingAddress.country %> - <%=
                                                            order.shippingAddress.zip_code %><br>
                                                            Phone: <%= order.shippingAddress.phone_number %>
                                    </address>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('../../partials/footer') %>
    </div>

    <div class="gototop js-top"><a href="#" class="js-gotop"><i class="ion-ios-arrow-up"></i></a></div>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.easing.1.3.js"></script>
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.flexslider-min.js"></script>
    <script src="/js/owl.carousel.min.js"></script>
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <script src="/js/magnific-popup-options.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="/css/sweetalert2.min.css">

    <script>
        function cancelOrder(orderId) {
            Swal.fire({
                title: 'Cancel Order?',
                text: "Please provide a reason for cancellation:",
                input: 'text',
                inputAttributes: {
                    autocapitalize: 'off'
                },
                showCancelButton: true,
                confirmButtonText: 'Yes, cancel it!',
                showLoaderOnConfirm: true,
                preConfirm: (reason) => {
                    return fetch(`/orders/cancel/${orderId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason })
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(response.statusText)
                            }
                            return response.json()
                        })
                        .catch(error => {
                            Swal.showValidationMessage(
                                `Request failed: ${error}`
                            )
                        })
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed) {
                    if (result.value.success) {
                        Swal.fire(
                            'Cancelled!',
                            result.value.message,
                            'success'
                        ).then(() => location.reload());
                    } else {
                        Swal.fire(
                            'Error!',
                            result.value.message,
                            'error'
                        );
                    }
                }
            })
        }

        function returnOrder(orderId) {
            Swal.fire({
                title: 'Return Order?',
                text: "Please provide a reason for return (Mandatory):",
                input: 'text',
                inputValidator: (value) => {
                    if (!value) {
                        return 'You need to write a reason!'
                    }
                },
                showCancelButton: true,
                confirmButtonText: 'Yes, return it!',
                showLoaderOnConfirm: true,
                preConfirm: (reason) => {
                    return fetch(`/orders/return/${orderId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason })
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(response.statusText)
                            }
                            return response.json()
                        })
                        .catch(error => {
                            Swal.showValidationMessage(
                                `Request failed: ${error}`
                            )
                        })
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed) {
                    if (result.value.success) {
                        Swal.fire(
                            'Returned!',
                            result.value.message,
                            'success'
                        ).then(() => location.reload());
                    } else {
                        Swal.fire(
                            'Error!',
                            result.value.message,
                            'error'
                        );
                    }
                }
            })
        }
    </script>
</body>

</html>