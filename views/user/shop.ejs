<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= pageTitle %> - Footwear
    </title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="/css/animate.css">
    <link rel="stylesheet" href="/css/icomoon.css">
    <link rel="stylesheet" href="/css/ionicons.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/magnific-popup.css">
    <link rel="stylesheet" href="/css/flexslider.css">
    <link rel="stylesheet" href="/css/owl.carousel.min.css">
    <link rel="stylesheet" href="/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="/css/bootstrap-datepicker.css">
    <link rel="stylesheet" href="/fonts/flaticon/font/flaticon.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
</head>

<body>
    <div class="colorlib-loader"></div>
    <div id="page">
        <%- include('../partials/navbar-offer-search') %>

            <% /** * Helper: Robust URL Builder using URLSearchParams * This function takes an object of changes (key:
                value) and merges it with currentQuery. * Pass null as value to remove a key. */ function
                getUrl(changes) { let params=new URLSearchParams(); if (typeof currentQuery !=='undefined' ) { for (let
                key in currentQuery) { let val=currentQuery[key]; if (Array.isArray(val)) { val.forEach(v=>
                params.append(key, v));
                } else {
                params.append(key, val);
                }
                }
                }

                // 2. Apply changes
                for (let key in changes) {
                // First, delete existing key to avoid duplicates or to clear it
                params.delete(key);

                let val = changes[key];
                if (val === null || val === undefined) {
                // Key is already deleted, do nothing
                } else if (Array.isArray(val)) {
                val.forEach(v => params.append(key, v));
                } else {
                params.append(key, val);
                }
                }

                return '?' + params.toString();
                }

                /**
                * Helper for checkboxes (Brand/Color) to toggle values in the array
                */
                function getToggleUrl(key, value) {
                let currentVals = [];
                // Check if key exists in current params
                // We need to check currentQuery because URLSearchParams isn't directly exposed as a read object here
                // easily
                // without re-parsing, but we have currentQuery passed from controller.
                if (typeof currentQuery !== 'undefined' && currentQuery[key]) {
                currentVals = Array.isArray(currentQuery[key]) ? currentQuery[key] : [currentQuery[key]];
                }

                let newVals = [...currentVals];
                if (newVals.includes(value)) {
                // Remove if exists
                newVals = newVals.filter(v => v !== value);
                } else {
                // Add if not exists
                newVals.push(value);
                }

                let changes = {};
                if (newVals.length === 0) {
                changes[key] = null; // Signal to remove the key entirely
                } else {
                changes[key] = newVals;
                }

                return getUrl(changes);
                }
                %>

                <div class="breadcrumbs">
                    <div class="container">
                        <div class="row">
                            <div class="col">
                                <p class="bread"><span><a href="/">Home</a></span> / <span>Shop All Products</span></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="breadcrumbs-two">
                    <div class="container">
                        <div class="row">
                            <div class="col">
                                <div class="breadcrumbs-img" style="background-image: url(/images/cover-img-1.jpg);">
                                    <h2>Shop All Products</h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="colorlib-product">
                    <div class="container">
                        <div class="row">
                            <!-- Sidebar Filters -->
                            <div class="col-lg-3 col-xl-3">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="side border mb-1">
                                            <h3>Search</h3>
                                            <form method="GET" action="/shop" class="colorlib-form-2">
                                                <!-- Keep existing filters as hidden inputs if we want search to be additive via form -->
                                                <!-- But for simplicity, let's just use the form for search alone or simple inputs -->
                                                <div class="form-group">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" name="search"
                                                            placeholder="Search..." value="<%= search %>">
                                                        <span class="input-group-btn">
                                                            <button class="btn btn-primary" type="submit"><i
                                                                    class="icon-search3"></i></button>
                                                        </span>
                                                    </div>
                                                    <% if (search) { %>
                                                        <div class="mt-2 text-center">
                                                            <a href="<%= getUrl({ search: null }) %>"
                                                                class="text-danger small">Clear Search</a>
                                                        </div>
                                                        <% } %>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <div class="col-sm-12">
                                        <div class="side border mb-1">
                                            <h3>Filters</h3>

                                            <!-- Clear All -->
                                            <div class="mb-3">
                                                <a href="/shop" class="btn btn-outline-secondary btn-sm btn-block">Clear
                                                    All Filters</a>
                                            </div>

                                            <!-- Categories -->
                                            <div class="block-26 mb-2">
                                                <h4>Categories</h4>
                                                <div class="category-list d-flex flex-wrap gap-2">
                                                    <a href="<%= getUrl({ category: null }) %>"
                                                        class="btn btn-sm btn-outline-secondary <%= !selectedCategory ? 'active' : '' %>"
                                                        style="border-radius: 20px;">
                                                        All
                                                    </a>
                                                    <% categories.forEach(function(cat) { %>
                                                        <a href="<%= getUrl({ category: cat._id }) %>"
                                                            class="btn btn-sm btn-outline-secondary <%= selectedCategory == cat._id.toString() ? 'active' : '' %>"
                                                            style="border-radius: 20px;">
                                                            <%= cat.name %>
                                                        </a>
                                                        <% }); %>
                                                </div>
                                            </div>

                                            <!-- Brands -->
                                            <div class="block-26 mb-2">
                                                <h4>Brand</h4>
                                                <div style="max-height: 200px; overflow-y: auto;">
                                                    <% brands.forEach(function(brandItem) { %>
                                                        <div class="form-check">
                                                            <!-- Use a link wrapping the label effectively by using getToggleUrl logic via simple anchor -->
                                                            <!-- Or safer: Use a form that auto-submits. But user asked for links/urls mainly to preserve state. -->
                                                            <!-- Let's use simple links styled as checkboxes for maximum safety/no-js support -->
                                                            <% let isChecked=selectedBrand.includes(brandItem); let
                                                                linkUrl=getToggleUrl('brand', brandItem); %>
                                                                <a href="<%= linkUrl %>"
                                                                    class="d-flex align-items-center mb-1 text-dark"
                                                                    style="text-decoration: none;">
                                                                    <input type="checkbox" class="form-check-input mr-2"
                                                                        <%=isChecked ? 'checked' : '' %>
                                                                    onclick="location.href='<%= linkUrl %>'; return
                                                                        false;">
                                                                        <span>
                                                                            <%= brandItem %>
                                                                        </span>
                                                                </a>
                                                        </div>
                                                        <% }); %>
                                                </div>
                                            </div>

                                            <!-- Colors -->
                                            <div class="block-26 mb-2">
                                                <h4>Color</h4>
                                                <div style="max-height: 200px; overflow-y: auto;">
                                                    <% colors.forEach(function(col) { %>
                                                        <div class="form-check">
                                                            <% let isChecked=selectedColor.includes(col); let
                                                                linkUrl=getToggleUrl('color', col); %>
                                                                <a href="<%= linkUrl %>"
                                                                    class="d-flex align-items-center mb-1 text-dark"
                                                                    style="text-decoration: none;">
                                                                    <input type="checkbox" class="form-check-input mr-2"
                                                                        <%=isChecked ? 'checked' : '' %>
                                                                    onclick="location.href='<%= linkUrl %>'; return
                                                                        false;">
                                                                        <span>
                                                                            <%= col %>
                                                                        </span>
                                                                </a>
                                                        </div>
                                                        <% }); %>
                                                </div>
                                            </div>

                                            <!-- Price -->
                                            <div class="block-26 mb-4">
                                                <h4>Price Range</h4>
                                                <form method="GET" action="/shop">
                                                    <!-- Include hidden inputs to preserve other filters -->
                                                    <% for(let k in currentQuery) { if(k !=='minPrice' && k
                                                        !=='maxPrice' ) { let vals=Array.isArray(currentQuery[k]) ?
                                                        currentQuery[k] : [currentQuery[k]]; vals.forEach(v=> { %>
                                                        <input type="hidden" name="<%= k %>" value="<%= v %>">
                                                        <% }); } } %>

                                                            <div class="d-flex align-items-center gap-2">
                                                                <input type="number" name="minPrice"
                                                                    class="form-control form-control-sm"
                                                                    placeholder="Min" value="<%= minPrice %>" min="0">
                                                                <span>-</span>
                                                                <input type="number" name="maxPrice"
                                                                    class="form-control form-control-sm"
                                                                    placeholder="Max" value="<%= maxPrice %>" min="0">
                                                            </div>
                                                            <button type="submit"
                                                                class="btn btn-primary btn-sm btn-block mt-2">Filter
                                                                Price</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Product Grid -->
                            <div class="col-lg-9 col-xl-9">
                                <div class="row row-pb-md">
                                    <div class="col-md-12 mb-4">
                                        <div
                                            class="d-flex justify-content-between align-items-center bg-light p-2 rounded">
                                            <span>Showing <%= products.length %> of <%= totalProducts %> results</span>
                                            <div class="form-inline">
                                                <label class="mr-2">Sort by:</label>
                                                <select class="form-control form-control-sm"
                                                    onchange="location = this.value;">
                                                    <option value="<%= getUrl({ sort: 'newest' }) %>"
                                                        <%=selectedSort==='newest' ? 'selected' : '' %>>Newest Arrivals
                                                    </option>
                                                    <option value="<%= getUrl({ sort: 'priceLowHigh' }) %>"
                                                        <%=selectedSort==='priceLowHigh' ? 'selected' : '' %>>Price: Low
                                                        to High</option>
                                                    <option value="<%= getUrl({ sort: 'priceHighLow' }) %>"
                                                        <%=selectedSort==='priceHighLow' ? 'selected' : '' %>>Price:
                                                        High to Low</option>
                                                    <option value="<%= getUrl({ sort: 'az' }) %>" <%=selectedSort==='az'
                                                        ? 'selected' : '' %>>Name: A - Z</option>
                                                    <option value="<%= getUrl({ sort: 'za' }) %>" <%=selectedSort==='za'
                                                        ? 'selected' : '' %>>Name: Z - A</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <% if (products.length> 0) { %>
                                        <% products.forEach(function(product) { let displayVariant=null; if
                                            (selectedColor && selectedColor.length> 0) {
                                            displayVariant = product.variants.find(function(v) {
                                            if (!v.colorImage) return false;

                                            // Check if this variant's color matches filter
                                            const matchesColor = selectedColor.some(sc =>
                                            new RegExp(sc, 'i').test(v.color)
                                            );

                                            if (!matchesColor) return false;

                                            // Check strict visibility
                                            const hasActiveSize = v.sizes && v.sizes.some(function(s) {
                                            return !s.isBlocked && s.status === 'Active';
                                            });
                                            return hasActiveSize;
                                            });
                                            }

                                            // 2. Fallback to any active variant if no color filter or no match found
                                            if (!displayVariant && product.variants) {
                                            displayVariant = product.variants.find(function(v) {
                                            return v.colorImage && v.sizes && v.sizes.some(function(s) {
                                            return !s.isBlocked && s.status === 'Active';
                                            });
                                            });
                                            }

                                            if (displayVariant) {
                                            %>
                                            <div class="col-md-4 col-lg-4 mb-4 text-center">
                                                <div class="product-entry border">
                                                    <div class="prod-img">
                                                        <a href="/product/<%= product._id %>" class="d-block">
                                                            <img src="<%= displayVariant.variantImages[0] %>"
                                                                class="img-fluid" alt="<%= product.productName %>"
                                                                style="height: 250px; object-fit: cover;"
                                                                onerror="this.src='/images/placeholder.png'">
                                                        </a>
                                                        <% if (typeof user !=='undefined' && user) { %>
                                                            <button class="btn btn-light btn-sm position-absolute"
                                                                style="top: 10px; right: 10px; z-index: 10; border-radius: 50%; width: 35px; height: 35px; padding: 0; display: flex; align-items: center; justify-content: center;"
                                                                onclick="toggleWishlist('<%= product._id %>', this)">
                                                                <% if (user.wishlist.some(id=> id.toString() ===
                                                                    product._id.toString())) { %>
                                                                    <i class="icon-heart" style="color: red;"></i>
                                                                    <% } else { %>
                                                                        <i class="icon-heart-o"></i>
                                                                        <% } %>
                                                            </button>
                                                            <% } else { %>
                                                                <button class="btn btn-light btn-sm position-absolute"
                                                                    style="top: 10px; right: 10px; z-index: 10; border-radius: 50%; width: 35px; height: 35px; padding: 0; display: flex; align-items: center; justify-content: center;"
                                                                    onclick="window.location.href='/login'">
                                                                    <i class="icon-heart-o"></i>
                                                                </button>
                                                                <% } %>
                                                    </div>
                                                    <div class="desc">
                                                        <h2><a href="/product/<%= product._id %>">
                                                                <%= product.productName %>
                                                            </a></h2>
                                                        <div class="mb-2">
                                                            <% // Filter for unique, active, unblocked variants let
                                                                uniqueColors=[]; if (product.variants) {
                                                                product.variants.forEach(v=> {
                                                                const hasActiveSize = v.sizes && v.sizes.some(s =>
                                                                !s.isBlocked && s.status === 'Active');
                                                                if (v.colorImage && hasActiveSize) {
                                                                // Check if color already added (case insensitive)
                                                                if (!uniqueColors.some(c => c.color.toLowerCase() ===
                                                                v.color.toLowerCase())) {
                                                                uniqueColors.push({ color: v.color, colorImage:
                                                                v.colorImage });
                                                                }
                                                                }
                                                                });
                                                                }
                                                                %>
                                                                <div
                                                                    class="d-flex justify-content-center gap-1 flex-wrap">
                                                                    <% uniqueColors.forEach(function(vc) { %>
                                                                        <span class="badge bg-light text-dark border"
                                                                            style="font-weight: normal;">
                                                                            <%= vc.color %>
                                                                        </span>
                                                                        <% }); %>
                                                                </div>
                                                        </div>
                                                        <span class="price">
                                                            <% if(product.salePrice < product.regularPrice) { %>
                                                                <span class="text-muted mr-2"
                                                                    style="text-decoration: line-through;">₹<%=
                                                                        product.regularPrice %></span>
                                                                <span class="text-danger">₹<%= product.salePrice %>
                                                                </span>
                                                                <% } else { %>
                                                                    ₹<%= product.salePrice %>
                                                                        <% } %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } %>
                                                <% }); %>
                                                    <% } else { %>
                                                        <div class="col-12 text-center py-5">
                                                            <div class="alert alert-info">No products found matching
                                                                your criteria.</div>
                                                            <a href="/shop" class="btn btn-primary mt-3">Reset
                                                                Filters</a>
                                                        </div>
                                                        <% } %>
                                </div>

                                <!-- Pagination -->
                                <% if (products.length> 0 && totalPages > 1) { %>
                                    <div class="row">
                                        <div class="col-md-12 text-center">
                                            <div class="block-27">
                                                <ul>
                                                    <% if (currentPage> 1) { %>
                                                        <li><a href="<%= getUrl({ page: currentPage - 1 }) %>"><i
                                                                    class="ion-ios-arrow-back"></i></a></li>
                                                        <% } %>
                                                            <% for(var i=1; i <=totalPages; i++) { %>
                                                                <% if (i===currentPage) { %>
                                                                    <li class="active"><span>
                                                                            <%= i %>
                                                                        </span></li>
                                                                    <% } else { %>
                                                                        <li><a href="<%= getUrl({ page: i }) %>">
                                                                                <%= i %>
                                                                            </a></li>
                                                                        <% } %>
                                                                            <% } %>
                                                                                <% if (currentPage < totalPages) { %>
                                                                                    <li><a
                                                                                            href="<%= getUrl({ page: currentPage + 1 }) %>"><i
                                                                                                class="ion-ios-arrow-forward"></i></a>
                                                                                    </li>
                                                                                    <% } %>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <%- include('../partials/footer') %>
    </div>
    <div class="gototop js-top"><a href="#" class="js-gotop"><i class="ion-ios-arrow-up"></i></a></div>

    <!-- Scripts -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.easing.1.3.js"></script>
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.flexslider-min.js"></script>
    <script src="/js/owl.carousel.min.js"></script>
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <script src="/js/magnific-popup-options.js"></script>
    <script src="/js/bootstrap-datepicker.js"></script>
    <script src="/js/jquery.stellar.min.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/wishlist.js"></script>
</body>

</html>