<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>
    <%= title %>
  </title>

  <!-- Only your combined CSS links; old template <head> tags belong here -->
  <link rel="stylesheet" href="/css/animate.css" />
  <link rel="stylesheet" href="/css/icomoon.css" />
  <link rel="stylesheet" href="/css/ionicons.min.css" />
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/magnific-popup.css" />
  <link rel="stylesheet" href="/css/flexslider.css" />
  <link rel="stylesheet" href="/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/css/bootstrap-datepicker.css" />
  <link rel="stylesheet" href="/fonts/flaticon/font/flaticon.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
  <div class="colorlib-loader"></div>
  <div id="page">
    <%- include('../partials/navbar-offer-search') %>


      <aside id="colorlib-hero">
        <div class="flexslider">
          <ul class="slides">
            <li style="background-image: url(https://res.cloudinary.com/dlbxw539c/image/upload/v1773576423/img_bg_1_wxv78e.jpg);">
              <div class="overlay"></div>
              <div class="container-fluid">
                <div class="row">
                  <div class="col-sm-6 offset-sm-3 text-center slider-text">
                    <div class="slider-text-inner">
                      <div class="desc">
                        <h1 class="head-1">Men's</h1>
                        <h2 class="head-2">Shoes</h2>
                        <h2 class="head-3">Collection</h2>
                        <p class="category"><span>New trending shoes</span></p>
                        <p><a href="/shop" class="btn btn-primary">Shop Collection</a></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
            <li style="background-image: url(https://res.cloudinary.com/dlbxw539c/image/upload/v1773576423/img_bg_2_xiyg9o.jpg);">
              <div class="overlay"></div>
              <div class="container-fluid">
                <div class="row">
                  <div class="col-sm-6 offset-sm-3 text-center slider-text">
                    <div class="slider-text-inner">
                      <div class="desc">
                        <h1 class="head-1">Huge</h1>
                        <h2 class="head-2">Sale</h2>
                        <h2 class="head-3"><strong class="font-weight-bold">50%</strong> Off</h2>
                        <p class="category"><span>Big sale sandals</span></p>
                        <p><a href="/shop" class="btn btn-primary">Shop Collection</a></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
            <li style="background-image: url(https://res.cloudinary.com/dlbxw539c/image/upload/v1773576423/img_bg_3_lp0zne.jpg);">
              <div class="overlay"></div>
              <div class="container-fluid">
                <div class="row">
                  <div class="col-sm-6 offset-sm-3 text-center slider-text">
                    <div class="slider-text-inner">
                      <div class="desc">
                        <h1 class="head-1">New</h1>
                        <h2 class="head-2">Arrival</h2>
                        <h2 class="head-3">up to <strong class="font-weight-bold">30%</strong> off</h2>
                        <p class="category"><span>New stylish shoes for men</span></p>
                        <p><a href="/shop" class="btn btn-primary">Shop Collection</a></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          </ul>
        </div>
      </aside>

      <div class="colorlib-intro">
        <div class="container">
          <div class="row">
            <div class="col-sm-12 text-center">
              <h2 class="intro">It started with a simple idea: Create quality, well-designed products that I wanted
                myself.</h2>
            </div>
          </div>
        </div>
      </div>

      <div class="colorlib-product">
        <div class="container-fluid">
          <div class="row">
            <div class="col-sm-6 text-center">
              <div class="featured">
                <a href="/men" class="featured-img" style="background-image: url(https://res.cloudinary.com/dlbxw539c/image/upload/v1773576437/men_hxkj6c.jpg);"></a>
                <div class="desc">
                  <h2><a href="/men">Shop Men's Collection</a></h2>
                </div>
              </div>
            </div>
            <div class="col-sm-6 text-center">
              <div class="featured">
                <a href="/women" class="featured-img" style="background-image: url(https://res.cloudinary.com/dlbxw539c/image/upload/v1773576442/women_ldagrx.jpg);"></a>
                <div class="desc">
                  <h2><a href="/women">Shop Women's Collection</a></h2>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Best Sellers section -->
      <div class="colorlib-product">
        <div class="container">
          <div class="row">
            <div class="col-sm-8 offset-sm-2 text-center colorlib-heading">
              <h2>Best Sellers</h2>
            </div>
          </div>
          <div class="row row-pb-md">
            <!-- 16 product cards (keep all 16 as in your original HTML) -->
            <!-- Dynamic products loop -->
            <% if (typeof products !=='undefined' && products.length> 0) { %>
              <% products.forEach(product=> { %>
                <div class="col-lg-3 mb-4 text-center">
                  <div class="product-entry border">
                    <a href="/product/<%= product._id %>" class="prod-img">
                        <img
                          src="<%= product.variants.variantImages[0] %>"
                          class="img-fluid" alt="<%= product.productName %>"
                          style="max-height: 250px; object-fit: contain;" onerror="this.src='/images/placeholder.png'">
                    </a>
                    <div class="desc">
                      <h2><a href="/product/<%= product._id %>">
                          <%= product.productName %> (<%= product.variants.color %>)
                        </a></h2>
                      <span class="price">
                            <% 
                                let fP = product.salePrice;
                                let sP = product.regularPrice;
                                let dP = 0;

                                if (product.hasOffer) {
                                  fP = product.discountedPrice;
                                  sP = product.salePrice; 
                                  dP = product.offerDiscount;
                                } else if (product.salePrice < product.regularPrice) {
                                  fP = product.salePrice;
                                  sP = product.regularPrice;
                                  dP = Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100);
                                }
                            %>

                            <% if (fP < sP) { %>
                              <span class="text-danger fw-bold">₹<%= fP %></span>
                              <span class="text-muted" style="text-decoration: line-through; font-size: 0.9em; margin-left: 5px;">₹<%= sP %></span>
                              <% if (dP > 0) { %>
                                <span class="badge bg-success text-white" style="font-size: 0.7em; margin-left: 5px; vertical-align: middle;"><%= dP %>% OFF</span>
                              <% } %>
                            <% } else { %>
                              <span class="text-dark fw-bold">₹<%= fP %></span>
                            <% } %>
                      </span>
                    </div>
                  </div>
                </div>
                <% }) %>
) %>
                  <% } else { %>
                    <div class="col-12 text-center">
                      <p>No products available yet. Check back later!</p>
                    </div>
                    <% } %>

          </div>
          <div class="row">
            <div class="col-md-12 text-center">
              <p><a href="/shop" class="btn btn-primary btn-lg">Shop All Products</a></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Trusted Partners (no glow on these images) -->
      <div class="colorlib-partner">
        <div class="container">
          <div class="row">
            <div class="col-sm-8 offset-sm-2 text-center colorlib-heading colorlib-heading-sm">
              <h2>Trusted Partners</h2>
            </div>
          </div>
          <div class="row">
            <div class="col partner-col text-center">
              <img src="https://res.cloudinary.com/dlbxw539c/image/upload/v1773576419/brand-1_zx3xvm.jpg" class="img-fluid" alt="Free html4 bootstrap 4 template">
            </div>
            <div class="col partner-col text-center">
              <img src="https://res.cloudinary.com/dlbxw539c/image/upload/v1773576419/brand-2_qlawx9.jpg" class="img-fluid" alt="Free html4 bootstrap 4 template">
            </div>
            <div class="col partner-col text-center">
              <img src="https://res.cloudinary.com/dlbxw539c/image/upload/v1773576419/brand-3_puendg.jpg" class="img-fluid" alt="Free html4 bootstrap 4 template">
            </div>
            <div class="col partner-col text-center">
              <img src="https://res.cloudinary.com/dlbxw539c/image/upload/v1773576419/brand-4_wmbqbh.jpg" class="img-fluid" alt="Free html4 bootstrap 4 template">
            </div>
            <div class="col partner-col text-center">
              <img src="https://res.cloudinary.com/dlbxw539c/image/upload/v1773576420/brand-5_ujtchn.jpg" class="img-fluid" alt="Free html4 bootstrap 4 template">
            </div>
          </div>
        </div>
      </div>
      <%- include('../partials/footer') %>
  </div>

  <!-- later: script tags here -->
  <script src="/js/jquery.min.js"></script>
  <script src="/js/popper.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/jquery.easing.1.3.js"></script>
  <script src="/js/jquery.waypoints.min.js"></script>
  <script src="/js/jquery.flexslider-min.js"></script>
  <script src="/js/owl.carousel.min.js"></script>
  <script src="/js/jquery.magnific-popup.min.js"></script>
  <script src="/js/magnific-popup-options.js"></script>
  <script src="/js/bootstrap-datepicker.js"></script>
  <script src="/js/jquery.stellar.min.js"></script>
  <script src="/js/main.js"></script>
  <script>
    // Force a reload if the page is loaded from the Back-Forward Cache (BFCache)
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>
</body>

</html>