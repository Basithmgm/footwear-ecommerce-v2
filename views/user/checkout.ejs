<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= pageTitle %> - Footwear
    </title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="stylesheet" href="/css/animate.css">
    <link rel="stylesheet" href="/css/icomoon.css">
    <link rel="stylesheet" href="/css/ionicons.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .address-card {
            border: 1px solid #ddd;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .address-card:hover {
            border-color: #88c8bc;
            background-color: #f9f9f9;
        }

        .address-card.selected {
            border-color: #88c8bc;
            background-color: #eafef8;
            border-width: 2px;
        }

        .checkout-summary {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
        }

        /* Hide radio button visually but keep it functional */
        .address-radio {
            display: none;
        }
    </style>
</head>

<body>

    <div class="colorlib-loader"></div>

    <div id="page">
        <%- include('../partials/navbar-offer-search') %>

            <div class="breadcrumbs" style="padding-bottom: 1em; margin-bottom: 0;">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <p class="bread" style="margin-bottom: 0;"><span><a href="/">Home</a></span> / <span><a href="/cart">Cart</a></span> /
                                <span>Checkout</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="colorlib-product" style="padding-top: 2em;">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-8 offset-sm-2 text-center colorlib-heading mb-4" style="margin-bottom: 2em;">
                            <h2>Checkout</h2>
                        </div>
                    </div>
                    <div class="row">
                        <!-- Right Column (Desktop): Order Summary -->
                        <!-- Reordering for mobile: summary usually bottom, but let's stick to standard layout -->

                        <div class="col-lg-8">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="cart-detail">
                                        <h2>Shipping Address</h2>

                                        <div class="row" id="address-list">
                                            <% if (addresses.length> 0) { %>
                                                <% addresses.forEach((addr, index)=> { %>
                                                    <div class="col-md-6">
                                                        <label
                                                            class="address-card w-100 <%= index === 0 ? 'selected' : '' %>"
                                                            id="card-<%= addr._id %>">
                                                            <input type="radio" name="addressId" class="address-radio"
                                                                value="<%= addr._id %>" <%=index===0 ? 'checked' : ''
                                                                %>>
                                                            <strong>
                                                                <%= addr.full_address %>
                                                            </strong>
                                                            <% if (addr.is_default) { %>
                                                                <span
                                                                    style="background-color: #28a745; color: white; font-size: 10px; padding: 2px 6px; border-radius: 10px; margin-left: 5px; font-weight: bold;">Default</span>
                                                                <% } %>
                                                                    <br>
                                                                    <%= addr.city %>, <%= addr.state %><br>
                                                                            <%= addr.country %> - <%= addr.zip_code %>
                                                                                    <br>
                                                                                    Phone: <%= addr.phone_number %>
                                                        </label>
                                                    </div>
                                                    <% }); %>
                                                        <% } else { %>
                                                            <div class="col-12">
                                                                <p>No addresses found. Please add one.</p>
                                                            </div>
                                                            <% } %>

                                                                <div
                                                                    class="col-md-6 d-flex align-items-center justify-content-center">
                                                                    <button class="btn btn-outline-primary w-100 h-100"
                                                                        style="min-height: 120px; border-style: dashed;"
                                                                        data-toggle="modal"
                                                                        data-target="#addAddressModal">
                                                                        <i class="icon-plus"></i> Add New Address
                                                                    </button>
                                                                </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12 mt-4">
                                    <div class="cart-detail">
                                        <h2>Payment Method</h2>
                                        <div class="form-group">
                                            <div class="col-md-12">
                                                <div class="radio">
                                                    <label><input type="radio" name="payment" value="COD" checked> Cash
                                                        on Delivery</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
    <div class="col-md-12">
        <div class="radio">
            <label>
                <input type="radio" name="payment" value="Wallet" <%= walletBalance < total ? 'disabled' : '' %>> 
                Wallet Balance (₹<%= walletBalance.toFixed(2) %>)
                <% if(walletBalance < total) { %>
                    <span class="text-danger small">- Insufficient Balance</span>
                <% } %>
            </label>
        </div>
    </div>
</div>

                                        <div class="form-group">
                                            <div class="col-md-12">
                                                <div class="radio">
                                                    <label><input type="radio" name="payment" value="Online"> 
                                                        Online Payment (Razorpay)</label>
                                                </div>
                                            </div>
                                        </div>


                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <!-- Coupon Application Box -->
                            <div class="checkout-summary mb-4">
                                <h3 class="mb-3">Apply Coupon</h3>
                                <% if (appliedCoupon) { %>
                                    <div class="alert alert-success d-flex justify-content-between align-items-center mb-0 px-3 py-2">
                                        <div>
                                            <strong class="text-success" style="font-size: 16px;"><i class="icon-tag"></i> <%= appliedCoupon.code %></strong> applied!
                                            <div class="small font-weight-bold mt-1 text-dark">Discount: - ₹<%= couponDiscountAmount %></div>
                                        </div>
                                        <button class="btn btn-sm btn-danger py-1 px-2" onclick="removeCoupon()">Remove</button>
                                    </div>
                                <% } else { %>
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" id="couponCodeInput" placeholder="Enter coupon code" style="text-transform: uppercase; height: 45px;">
                                        <div class="input-group-append">
                                            <button class="btn btn-primary px-3" type="button" onclick="applyCouponInput()" style="height: 45px;">Apply</button>
                                        </div>
                                    </div>
                                    
                                    <% if (activeCoupons && activeCoupons.length > 0) { %>
                                        <h6 class="mt-4 mb-2 text-muted font-weight-bold"><i class="icon-tags"></i> Available Coupons</h6>
                                        <div style="max-height: 250px; overflow-y: auto; padding-right: 5px;" class="custom-scrollbar">
                                            <% activeCoupons.forEach(coupon => { %>
                                                <div class="border p-2 mb-2 rounded shadow-sm" style="background-color: #fff; border-color: #eee !important;">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="badge badge-success px-2 py-1" style="font-size: 13px; letter-spacing: 1px;"><%= coupon.code %></span>
                                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 cursor-pointer" style="font-size: 12px; border-width: 2px;" onclick="applyCouponDirect('<%= coupon.code %>')">Apply</button>
                                                    </div>
                                                    <div class="text-dark font-weight-bold mt-2" style="font-size: 14px;">
                                                        Get <%= coupon.discountType === 'Percentage' ? coupon.discountValue + '% OFF' : '₹' + coupon.discountValue + ' OFF' %>
                                                    </div>
                                                    <div class="small text-muted mt-1">
                                                        On minimum purchase of ₹<%= coupon.minPurchaseAmount %>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>

                            <div class="checkout-summary">
                                <h3>Order Summary</h3>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal</span>
                                    <span>₹<%= originalTotal || subtotal %></span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Discount</span>
                                    <span class="text-success">- ₹<%= (totalDiscount || 0) %></span>
                                </div>
                                <% if (couponDiscountAmount > 0) { %>
                                <div class="d-flex justify-content-between mb-2 font-weight-bold text-success">
                                    <span>Coupon (<%= appliedCoupon.code %>)</span>
                                    <span>- ₹<%= couponDiscountAmount %></span>
                                </div>
                                <% } %>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Shipping</span>
                                    <span>
                                        <%= shippingFee===0 ? 'Free' : '₹' + shippingFee %>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tax</span>
                                    <span>₹<%= tax %></span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between mb-4">
                                    <span class="font-weight-bold">Total</span>
                                    <span class="font-weight-bold h5" id="cart-total-value">₹<%= total %></span>
                                </div>

                                <h5>Items</h5>
                                <ul class="list-group mb-4" style="max-height: 300px; overflow-y: auto;">
                                    <% cartItems.forEach(item=> { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center">
                                                <img src="<%= item.image %>" alt="Product"
                                                    style="width: 40px; height: 40px; margin-right: 10px; object-fit: cover;">
                                                <div>
                                                    <div class="small font-weight-bold">
                                                        <%= item.productName %>
                                                    </div>
                                                    <div class="small text-muted">Size: <%= item.size %> | Qty: <%=
                                                                item.quantity %>
                                                    </div>
                                                    <% if(item.stockStatus !=='Available' ) { %>
                                                        <div class="text-danger small font-weight-bold">
                                                            <%= item.stockStatus %>
                                                        </div>
                                                        <% } %>
                                                </div>
                                            </div>
                                            <span class="small">₹<%= item.subtotal %></span>
                                        </li>
                                        <% }); %>
                                </ul>

                                <% if(hasUnavailable) { %>
                                    <div class="alert alert-warning small">Some items are unavailable. Please remove
                                        them from cart to proceed.</div>
                                    <a href="/cart" class="btn btn-secondary btn-block">Go to Cart</a>
                                    <% } else { %>
                                        <button id="btn-place-order" class="btn btn-primary btn-block py-3">Place
                                            Order</button>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Add Address Modal -->
            <div class="modal fade" id="addAddressModal" tabindex="-1" role="dialog"
                aria-labelledby="addAddressModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addAddressModalLabel">Add New Address</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form id="addAddressForm">
                                <div class="form-group">
                                    <label>Full Address</label>
                                    <input type="text" class="form-control" name="full_address" required>
                                </div>
                                <div class="form-group">
                                    <label>City</label>
                                    <input type="text" class="form-control" name="city" required>
                                </div>
                                <div class="form-group">
                                    <label>State</label>
                                    <input type="text" class="form-control" name="state" required>
                                </div>
                                <div class="form-group">
                                    <label>Country</label>
                                    <input type="text" class="form-control" name="country" required>
                                </div>
                                <div class="form-group">
                                    <label>Zip Code</label>
                                    <input type="text" class="form-control" name="zip_code" required>
                                </div>
                                <div class="form-group">
                                    <label>Phone Number</label>
                                    <input type="text" class="form-control" name="phone_number" required>
                                </div>
                                <button type="submit" class="btn btn-primary btn-block">Save Address</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('../partials/footer') %>
    </div>

    <div class="gototop js-top"><a href="#" class="js-gotop"><i class="ion-ios-arrow-up"></i></a></div>

    <!-- Scripts -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.easing.1.3.js"></script>
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.flexslider-min.js"></script>
    <script src="/js/owl.carousel.min.js"></script>
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <script src="/js/magnific-popup-options.js"></script>
    <script src="/js/main.js"></script>

    <!-- Razorpay SDK -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
        $(document).ready(function () {
            // Address Selection Highlight
            $('.address-radio').change(function () {
                $('.address-card').removeClass('selected');
                $(this).closest('.address-card').addClass('selected');
            });
            // Also enable click on card to select radio
            $('.address-card').click(function () {
                $(this).find('input[type="radio"]').prop('checked', true).trigger('change');
            });

            // Add Address Form Submit
            $('#addAddressForm').submit(async function (e) {
                e.preventDefault();
                const formData = new FormData(this);
                const payload = {};
                formData.forEach((value, key) => payload[key] = value);

                try {
                    const response = await fetch('/checkout/add-address', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const resData = await response.json();

                    if (resData.success) {
                        $('#addAddressModal').modal('hide');
                        Swal.fire({ icon: 'success', title: 'Address Added', showConfirmButton: false, timer: 1500 });
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire('Error', resData.message, 'error');
                    }
                } catch (err) {
                    console.error(err);
                    Swal.fire('Error', 'Failed to add address', 'error');
                }
            });

            // Place Order (COD / Wallet / Razorpay)
            $('#btn-place-order').click(async function () {
                const addressId = $('input[name="addressId"]:checked').val();
                const paymentMethod = $('input[name="payment"]:checked').val();

                if (!addressId) {
                    Swal.fire('Warning', 'Please select a shipping address', 'warning');
                    return;
                }

                if (paymentMethod === 'Online') {
                    startRazorpay(addressId);
                    return;
                }

                $(this).prop('disabled', true).text('Processing...');

                try {
                    const response = await fetch('/checkout/place-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ addressId, paymentMethod })
                    });
                    const resData = await response.json();

                    if (resData.success) {
                        window.location.href = `/checkout/success/${resData.orderId}`;
                    } else {
                        Swal.fire('Error', resData.message, 'error');
                        $(this).prop('disabled', false).text('Place Order');
                    }
                } catch (err) {
                    console.error(err);
                    Swal.fire('Error', 'Failed to place order', 'error');
                    $(this).prop('disabled', false).text('Place Order');
                }
            });

            async function startRazorpay(addressId) {
                try {
                    const response = await fetch('/checkout/razorpay/create-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ addressId })
                    });
                    const data = await response.json();

                    if (data.success) {
                        const options = {
                            key: data.key_id,
                            amount: data.order.amount,
                            currency: "INR",
                            name: "Footwear",
                            description: "Payment for your order",
                            order_id: data.order.id,
                            handler: async function (response) {
                                try {
                                    const verifyRes = await fetch('/checkout/razorpay/verify-payment', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            razorpay_order_id: response.razorpay_order_id,
                                            razorpay_payment_id: response.razorpay_payment_id,
                                            razorpay_signature: response.razorpay_signature,
                                            orderId: data.orderId
                                        })
                                    });
                                    const verifyData = await verifyRes.json();
                                    if (verifyData.success) {
                                        window.location.href = `/checkout/success/${verifyData.orderId}`;
                                    } else {
                                        Swal.fire('Error', verifyData.message, 'error').then(() => {
                                            window.location.href = '/orders'; // Redirect to orders since order is saved as Pending
                                        });
                                    }
                                } catch (err) {
                                    Swal.fire('Error', 'Payment verification failed', 'error').then(() => {
                                        window.location.href = '/orders';
                                    });
                                }
                            },
                            "modal": {
                                "ondismiss": function(){
                                    Swal.fire({
                                        title: 'Payment Interrupted',
                                        text: "Your order has been saved as 'Payment Pending'. You can complete the payment later from your order history.",
                                        icon: 'info',
                                        confirmButtonText: 'Go to My Orders'
                                    }).then(() => {
                                        window.location.href = '/orders';
                                    });
                                }
                            },
                            prefill: {
                                name: "<%= user?.full_name || '' %>",
                                email: "<%= user?.email || '' %>",
                            },
                            theme: { color: "#88c8bc" }
                        };
                        const rzp1 = new Razorpay(options);
                        rzp1.open();
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (err) {
                    console.error(err);
                    Swal.fire('Error', 'Failed to initialize Razorpay', 'error');
                }
            }

            // Coupon Logic
            window.applyCouponInput = function() {
                const code = $('#couponCodeInput').val().trim();
                applyCouponDirect(code);
            };

            window.applyCouponDirect = async function(code) {
                if (!code) {
                    Swal.fire('Warning', 'Please enter a coupon code.', 'warning');
                    return;
                }
                try {
                    const response = await fetch('/checkout/apply-coupon', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ couponCode: code })
                    });
                    const resData = await response.json();
                    if (resData.success) {
                        Swal.fire({ icon: 'success', title: 'Coupon Applied', text: resData.message, showConfirmButton: false, timer: 1500 });
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire('Error', resData.message, 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', 'Failed to apply coupon.', 'error');
                }
            };

            window.removeCoupon = async function() {
                try {
                    const response = await fetch('/checkout/remove-coupon', { method: 'POST' });
                    const resData = await response.json();
                    if (resData.success) {
                        Swal.fire({ icon: 'success', title: 'Coupon Removed', showConfirmButton: false, timer: 1500 });
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire('Error', resData.message, 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', 'Failed to remove coupon.', 'error');
                }
            };
        });
    </script>
    <script>
    // Force a reload if the page is loaded from the Back-Forward Cache (BFCache)
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>
</body>

</html>