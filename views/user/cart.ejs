<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= pageTitle %> - Footwear
    </title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="stylesheet" href="/css/animate.css">
    <link rel="stylesheet" href="/css/icomoon.css">
    <link rel="stylesheet" href="/css/ionicons.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/magnific-popup.css">
    <link rel="stylesheet" href="/css/flexslider.css">
    <link rel="stylesheet" href="/css/owl.carousel.min.css">
    <link rel="stylesheet" href="/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="/css/bootstrap-datepicker.css">
    <link rel="stylesheet" href="/fonts/flaticon/font/flaticon.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

    <div class="colorlib-loader"></div>

    <div id="page">
        <%- include('../partials/navbar-offer-search') %>

            <div class="breadcrumbs" style="padding-bottom: 1em; margin-bottom: 0;">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <p class="bread" style="margin-bottom: 0;"><span><a href="/">Home</a></span> / <span>Shopping Cart</span></p>
                        </div>
                    </div>
                </div>
            </div>


            <div class="colorlib-product cart-container" style="padding-top: 0.5em;">
                <div class="container">
                    <div class="row mb-2">
                        <div class="col-sm-8 offset-sm-2 text-center colorlib-heading" style="margin-bottom: 1em;">
                            <h2>Cart</h2>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="product-name d-flex align-items-center bg-light rounded shadow-sm mb-3 font-weight-bold" style="padding: 15px 0;">
                                <div class="one-forth text-left px-4">
                                    <span>Product Details</span>
                                </div>
                                <div class="one-eight text-center">
                                    <span>Price</span>
                                </div>
                                <div class="one-eight text-center">
                                    <span>Quantity</span>
                                </div>
                                <div class="one-eight text-center">
                                    <span>Total</span>
                                </div>
                                <div class="one-eight text-center px-4">
                                    <span>Remove</span>
                                </div>
                            </div>

                            <% if(cartItems && cartItems.length> 0) { %>
                                <% cartItems.forEach(item=> { %>
                                    <div class="product-cart d-flex align-items-center border rounded shadow-sm mb-3 bg-white" id="row-<%= item._id %>" style="padding: 10px 0;">
                                        <div class="one-forth">
                                            <div class="product-img"
                                                style="background-image: url('<%= item.image %>');">
                                            </div>
                                            <div class="display-tc">
                                                <h3>
                                                    <%= item.productName %>
                                                </h3>
                                                <span class="text-muted d-block small">Color: <%= item.variantId %> |
                                                        Size: <%= item.size %></span>
                                                <% if(item.stockStatus !=='Available' ) { %>
                                                    <span class="text-danger small font-weight-bold">
                                                        <%= item.stockStatus %>
                                                    </span>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <div class="one-eight text-center">
                                            <div class="display-tc">
                                                <span class="price">₹<%= item.price %></span>
                                            </div>
                                        </div>
                                        <div class="one-eight text-center">
                                            <div class="display-tc">
                                                <div class="qty-group">
                                                    <button class="btn btn-qty btn-outline-secondary quantity-btn"
                                                        data-id="<%= item._id %>" data-action="minus"
                                                        <%=item.stockStatus !=='Available' ? 'disabled' : ''
                                                        %>>-</button>
                                                    <input type="text" id="qty-<%= item._id %>" name="quantity"
                                                        class="form-control input-number" value="<%= item.quantity %>"
                                                        min="1" max="5" readonly
                                                        style="width: 50px; text-align: center; display: inline-block;">
                                                    <button class="btn btn-qty btn-outline-secondary quantity-btn"
                                                        data-id="<%= item._id %>" data-action="plus" <%=item.stockStatus
                                                        !=='Available' ? 'disabled' : '' %>>+</button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="one-eight text-center">
                                            <div class="display-tc">
                                                <span class="price" id="total-<%= item._id %>">₹<%= item.subtotal %>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="one-eight text-center">
                                            <div class="display-tc">
                                                <div class="closed btn-remove-item" style="cursor: pointer;"
                                                    data-id="<%= item._id %>"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="text-center py-5">
                                                <h3>Your cart is empty</h3>
                                                <a href="/shop" class="btn btn-primary">Continue Shopping</a>
                                            </div>
                                            <% } %>
                        </div>
                    </div>

                    <% if(cartItems && cartItems.length> 0) { %>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="total-wrap p-4 bg-white border rounded shadow-sm mb-4">
                                    <div class="row">
                                        <div class="col-sm-8">
                                            <h4 class="mb-3">Apply Coupon</h4>
                                            <% if (appliedCoupon) { %>
                                                <div class="alert alert-success d-flex justify-content-between align-items-center mb-4 px-3 py-2" style="max-width: 400px;">
                                                    <div>
                                                        <strong class="text-success" style="font-size: 16px;"><i class="icon-tag"></i> <%= appliedCoupon.code %></strong> applied!
                                                        <div class="small font-weight-bold mt-1 text-dark">Discount: - ₹<%= couponDiscountAmount %></div>
                                                    </div>
                                                    <button class="btn btn-sm btn-danger py-1 px-2" onclick="removeCoupon()">Remove</button>
                                                </div>
                                            <% } else { %>
                                                <div class="input-group mb-4" style="max-width: 400px;">
                                                    <input type="text" class="form-control" id="couponCodeInput" placeholder="Enter coupon code" style="text-transform: uppercase; height: 45px;">
                                                    <div class="input-group-append">
                                                        <button class="btn btn-primary px-3" type="button" onclick="applyCouponInput()" style="height: 45px;">Apply</button>
                                                    </div>
                                                </div>
                                            <% } %>

                                            <h5 class="mb-3">Available Coupons</h5>
                                            <% if (typeof activeCoupons !== 'undefined' && activeCoupons.length > 0) { %>
                                                <div class="row">
                                                    <% activeCoupons.forEach(coupon => { %>
                                                        <div class="col-md-6 mb-3">
                                                            <div class="border p-3 rounded shadow-sm" style="background-color: #fff; border-color: #eee !important;">
                                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                                    <span class="badge badge-success px-2 py-1" style="font-size: 14px; letter-spacing: 1px;"><%= coupon.code %></span>
                                                                    <% if (!appliedCoupon) { %>
                                                                    <button class="btn btn-sm btn-outline-primary py-0 px-2 cursor-pointer" style="font-size: 12px; border-width: 2px;" onclick="applyCouponDirect('<%= coupon.code %>')">Apply</button>
                                                                    <% } %>
                                                                </div>
                                                                <div class="text-dark font-weight-bold" style="font-size: 15px;">
                                                                    Get <%= coupon.discountType === 'Percentage' ? coupon.discountValue + '% OFF' : '₹' + coupon.discountValue + ' OFF' %>
                                                                </div>
                                                                <div class="small text-muted mt-1">
                                                                    On minimum purchase of ₹<%= coupon.minPurchaseAmount %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                </div>
                                            <% } else { %>
                                                <p class="text-muted">No coupons available at the moment.</p>
                                            <% } %>
                                        </div>
                                        <div class="col-sm-4 text-center">
                                            <div class="total">
                                                <div class="sub">
                                                    <p><span>Subtotal:</span> <span id="cart-subtotal">₹<%=
                                                                originalTotal || subtotal %>
                                                        </span></p>
                                                    <p><span>Delivery:</span> <span>₹0.00</span></p>
                                                    <p><span>Offer Discount:</span> <span id="cart-discount"
                                                            class="text-success">- ₹<%= totalDiscount || 0 %></span></p>
                                                    <% if (appliedCoupon) { %>
                                                    <p><span>Coupon (<%= appliedCoupon.code %>):</span> <span class="text-success font-weight-bold">- ₹<%= couponDiscountAmount %></span></p>
                                                    <% } %>
                                                </div>
                                                <div class="grand-total">
                                                    <p><span><strong>Total:</strong></span> <span id="cart-total">₹<%=
                                                                finalTotal || subtotal %></span></p>
                                                </div>
                                            </div>
                                            <div class="checkout-btn-wrap">
                                                <% const hasUnavailable=cartItems.some(i=> i.stockStatus !==
                                                    'Available');
                                                    %>
                                                    <% if(hasUnavailable) { %>
                                                        <button class="btn btn-secondary btn-block" disabled>Checkout
                                                            Disabled (Item Unavailable)</button>
                                                        <% } else { %>
                                                            <a href="/checkout"
                                                                class="btn btn-primary btn-block">Proceed to
                                                                Checkout</a>
                                                            <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>
                </div>
            </div>

            <%- include('../partials/footer') %>
    </div>

    <div class="gototop js-top"><a href="#" class="js-gotop"><i class="ion-ios-arrow-up"></i></a></div>

    <!-- Script -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.easing.1.3.js"></script>
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.flexslider-min.js"></script>
    <script src="/js/owl.carousel.min.js"></script>
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <script src="/js/magnific-popup-options.js"></script>
    <script src="/js/bootstrap-datepicker.js"></script>
    <script src="/js/jquery.stellar.min.js"></script>
    <script src="/js/main.js"></script>

    <% const hasUnavailable=cartItems.some(i=> i.stockStatus !== 'Available'); %>
        <% if(hasUnavailable) { %>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Cart Update',
                        text: 'Some items in your cart are currently unavailable or out of stock. Please remove them to proceed with checkout.'
                    });
                });
            </script>
            <% } %>

                <script>
                    // Update Quantity with jQuery Delegation
                    $(document).on('click', '.quantity-btn', async function (e) {
                        e.preventDefault();

                        const btn = $(this);
                        const itemId = btn.data('id');
                        const action = btn.data('action');



                        // Disable button temporarily to prevent double submission
                        btn.prop('disabled', true);

                        try {
                            const response = await fetch('/cart/update-quantity', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ itemId, check: action })
                            });

                            const data = await response.json();

                            if (data.success) {
                                if (data.newQuantity) {
                                    $('#qty-' + itemId).val(data.newQuantity);
                                    $('#total-' + itemId).text('₹' + data.newItemTotal);
                                    $('#cart-subtotal').text('₹' + data.originalTotal);
                                    $('#cart-discount').text('- ₹' + data.totalDiscount);
                                    $('#cart-total').text('₹' + data.cartTotal);

                                    // Update Navbar Cart Count
                                    if (typeof data.cartCount !== 'undefined') {
                                        $('#navbar-cart-count').text(data.cartCount);
                                    }
                                }
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Limit Reached',
                                    text: data.message,
                                    showConfirmButton: false,
                                    timer: 2000
                                });
                            }
                        } catch (error) {
                            console.error('Error updating quantity:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Failed to update quantity. Please try again.',
                                showConfirmButton: false,
                                timer: 3000
                            });
                        } finally {
                            // Re-enable button
                            btn.prop('disabled', false);
                        }
                    });

                    $(document).ready(function () {
                        // REMOVE ITEM - Event Delegation
                        $(document).on('click', '.btn-remove-item', function (e) {
                            e.preventDefault();
                            e.stopPropagation();

                            const itemId = $(this).data('id');
                            console.log('Remove clicked for:', itemId);

                            const performRemove = async () => {
                                try {
                                    const response = await fetch('/cart/remove', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ itemId })
                                    });

                                    const data = await response.json();
                                    if (data.success) {
                                        $('#row-' + itemId).fadeOut(300, function () { $(this).remove(); });
                                        $('#cart-subtotal').text('₹' + data.originalTotal);
                                        $('#cart-discount').text('- ₹' + data.totalDiscount);
                                        $('#cart-total').text('₹' + data.cartTotal);

                                        // Update Navbar Cart Count
                                        if (typeof data.cartCount !== 'undefined') {
                                            $('#navbar-cart-count').text(data.cartCount);
                                        }

                                        const showSuccess = () => {
                                            if (data.cartCount === 0) location.reload();
                                        };

                                        if (typeof Swal !== 'undefined') {
                                            Swal.fire({
                                                icon: 'success',
                                                title: 'Removed!',
                                                text: 'Item has been removed.',
                                                timer: 1500,
                                                showConfirmButton: false
                                            }).then(showSuccess);
                                        } else {
                                            showSuccess();
                                        }
                                    } else {
                                        Swal.fire('Error', data.message || 'Failed to remove', 'error');
                                    }
                                } catch (error) {
                                    console.error('Error:', error);
                                    Swal.fire('Error', 'Error processing request', 'error');
                                }
                            };

                            Swal.fire({
                                title: 'Remove Item?',
                                text: "Are you sure you want to remove this?",
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33',
                                confirmButtonText: 'Yes, remove it!'
                            }).then((result) => {
                                if (result.isConfirmed) performRemove();
                            });
                        });
                    });

                    // Coupon Logic
                    window.applyCouponInput = function() {
                        const code = $('#couponCodeInput').val().trim();
                        applyCouponDirect(code);
                    };

                    window.applyCouponDirect = async function(code) {
                        if (!code) {
                            Swal.fire('Warning', 'Please enter a coupon code.', 'warning');
                            return;
                        }
                        try {
                            const response = await fetch('/checkout/apply-coupon', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ couponCode: code })
                            });
                            const resData = await response.json();
                            if (resData.success) {
                                Swal.fire({ icon: 'success', title: 'Coupon Applied', text: resData.message, showConfirmButton: false, timer: 1500 });
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                Swal.fire('Error', resData.message, 'error');
                            }
                        } catch (err) {
                            Swal.fire('Error', 'Failed to apply coupon.', 'error');
                        }
                    };

                    window.removeCoupon = async function() {
                        try {
                            const response = await fetch('/checkout/remove-coupon', { method: 'POST' });
                            const resData = await response.json();
                            if (resData.success) {
                                Swal.fire({ icon: 'success', title: 'Coupon Removed', showConfirmButton: false, timer: 1500 });
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                Swal.fire('Error', resData.message, 'error');
                            }
                        } catch (err) {
                            Swal.fire('Error', 'Failed to remove coupon.', 'error');
                        }
                    };
                </script>
                <script>
    // Force a reload if the page is loaded from the Back-Forward Cache (BFCache)
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>
</body>

</html>