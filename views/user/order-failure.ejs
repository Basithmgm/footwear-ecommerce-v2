<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= pageTitle %> - Footwear</title>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <link rel="stylesheet" href="/css/animate.css" />
    <link rel="stylesheet" href="/css/icomoon.css" />
    <link rel="stylesheet" href="/css/ionicons.min.css" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/custom.css" />
    <style>
      .failure-header {
        background: #fff5f5;
        color: #dc3545;
        padding: 50px 20px;
        border-radius: 15px 15px 0 0;
        border-bottom: 1px solid #ffe3e3;
      }
      .error-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(220, 53, 69, 0.08);
        background: white;
        overflow: hidden;
      }
      .btn-premium {
        padding: 12px 30px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s;
      }
      .btn-premium-danger {
        background: #dc3545;
        border: none;
        color: white;
      }
      .btn-premium-danger:hover {
        background: #c82333;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        color: white;
      }
      .btn-premium-outline {
        border: 2px solid #6c757d;
        color: #6c757d;
        background: transparent;
      }
      .btn-premium-outline:hover {
        background: #6c757d;
        color: white;
        transform: translateY(-2px);
      }
      .reason-list {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 20px;
      }
      .reason-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 15px;
      }
      .reason-item i {
        margin-right: 12px;
        margin-top: 3px;
        color: #dc3545;
      }
    </style>
  </head>

  <body>
    <div class="colorlib-loader"></div>
    <div id="page">
      <%- include('../partials/navbar-offer-search') %>

      <div class="colorlib-product mb-5">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-md-8">
              <div class="error-card mb-5">
                <div class="failure-header text-center">
                  <div class="icon mb-3">
                    <i class="ion-ios-close-circle-outline display-1"></i>
                  </div>
                  <h1 class="text-danger mb-2 font-weight-bold">Payment Failed</h1>
                  <p class="lead text-muted mb-0">We couldn't process your payment at this time.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                  <div class="alert alert-warning border-0 bg-light p-4 rounded-lg mb-5">
                    <h5 class="font-weight-bold mb-3"><i class="ion-ios-information-circle-outline mr-2"></i>What happened?</h5>
                    <p class="text-muted mb-4">Your transaction was unsuccessful. This can happen due to various reasons. Don't worry, no money has been deducted from your account (if it was, it will be refunded automatically).</p>
                    
                    <div class="reason-list">
                      <div class="reason-item">
                        <i class="ion-ios-arrow-dropright-circle"></i>
                        <span>The transaction was cancelled by you or your bank.</span>
                      </div>
                      <div class="reason-item">
                        <i class="ion-ios-arrow-dropright-circle"></i>
                        <span>Insufficient funds in the selected payment method.</span>
                      </div>
                      <div class="reason-item">
                        <i class="ion-ios-arrow-dropright-circle"></i>
                        <span>Network timeout or temporary technical issue with the payment gateway.</span>
                      </div>
                      <div class="reason-item">
                        <i class="ion-ios-arrow-dropright-circle"></i>
                        <span>Incorrect card details or expired security credentials.</span>
                      </div>
                    </div>
                  </div>

                  <div class="text-center py-4 border-top">
                    <h5 class="font-weight-bold mb-4">Your items are still in your cart!</h5>
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                      <a href="/checkout" class="btn btn-premium btn-premium-danger mx-2 mb-3">
                        <i class="icon-refresh mr-1"></i> Try Payment Again
                      </a>
                      <a href="/orders" class="btn btn-premium btn-premium-outline mx-2 mb-3">
                        <i class="icon-list mr-1"></i> View Order History
                      </a>
                      <a href="/shop" class="btn btn-premium btn-premium-outline mx-2 mb-3">
                        <i class="icon-shopping-cart mr-1"></i> Return to Shop
                      </a>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="text-center">
                <p class="text-muted">Need help completing your purchase?</p>
                <div class="mt-4">
                  <p class="small text-muted mb-0">Contact our support team for immediate assistance.</p>
                  <a href="/contact" class="text-primary font-weight-bold">Customer Support</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%- include('../partials/footer') %>
    </div>

    <div class="gototop js-top">
      <a href="#" class="js-gotop"><i class="ion-ios-arrow-up"></i></a>
    </div>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.easing.1.3.js"></script>
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.flexslider-min.js"></script>
    <script src="/js/owl.carousel.min.js"></script>
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <script src="/js/magnific-popup-options.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
