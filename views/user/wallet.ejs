<!DOCTYPE html>
<html lang="en">
<head>
  <title>My Wallet - Footwear</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  
  <link rel="stylesheet" href="/css/animate.css" />
  <link rel="stylesheet" href="/css/icomoon.css" />
  <link rel="stylesheet" href="/css/ionicons.min.css" />
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/magnific-popup.css" />
  <link rel="stylesheet" href="/css/flexslider.css" />
  <link rel="stylesheet" href="/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/css/bootstrap-datepicker.css" />
  <link rel="stylesheet" href="/fonts/flaticon/font/flaticon.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  
  <style>
    html, body {
      margin: 0; padding: 0; background-color: #f7f7f7; overflow-x: hidden !important; width: 100%;
    }
    #page {
      width: 100% !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important;
      background-color: transparent !important; overflow-x: hidden !important; position: relative;
    }
  </style>
</head>
<body>
  <div class="colorlib-loader"></div>
  <div id="page">
    <%- include('../partials/navbar-offer-search') %>

    <div class="breadcrumbs">
        <div class="container">
            <div class="row">
                <div class="col">
                    <p class="bread"><span><a href="/">Home</a></span> / <span><a href="/profile">Profile</a></span> / <span>My Wallet</span></p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-0 mb-5" style="max-width: 1100px;">
         <h2 style="text-align:center; color: black; font-weight: bold; margin-bottom: 30px; text-transform: uppercase; font-size: 28px;">My Wallet</h2>
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3">
                <div class="list-group" style="box-shadow: 0 0 15px rgba(0,0,0,0.05); border-radius: 8px;">
                    <a href="/profile" class="list-group-item list-group-item-action">Profile Information</a>
                    <a href="/profile/edit" class="list-group-item list-group-item-action">Manage Addresses</a>
                    <a href="/orders" class="list-group-item list-group-item-action">My Orders</a>
                    <a href="/cart" class="list-group-item list-group-item-action">Cart</a>
                    <a href="/wishlist" class="list-group-item list-group-item-action">Wishlist</a>
                    <a href="/wallet" class="list-group-item list-group-item-action active" style="background-color: #444; border-color: #444; font-weight: bold;">My Wallet</a>
                    <form action="/logout" method="POST" style="margin: 0;">
                        <button type="submit" class="list-group-item list-group-item-action text-danger" style="width: 100%; text-align: left; border-top: 1px solid rgba(0,0,0,.125); border-radius: 0 0 8px 8px;">Logout</button>
                    </form>
                </div>
            </div>

            <div class="col-md-9">
                <!-- Balance Card -->
                <div class="card mb-4" style="border: none; box-shadow: 0 0 15px rgba(0,0,0,0.05); border-radius: 8px; overflow: hidden;">
                    <div class="card-body text-center" style="background-color: white; padding: 40px;">
                        <h5 class="text-muted" style="text-transform: uppercase; letter-spacing: 1px; font-size: 14px;">Available Balance</h5>
                        <h2 style="color: #444; font-weight: bold; font-size: 3rem; margin-top: 10px;">₹<%= wallet.balance.toFixed(2) %></h2>
                        <button class="btn btn-primary mt-3" data-toggle="modal" data-target="#addMoneyModal" style="padding: 10px 30px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
                            <i class="icon-plus"></i> Add Money
                        </button>
                    </div>
                </div>

                <!-- Add Money Modal -->
                <div class="modal fade" id="addMoneyModal" tabindex="-1" role="dialog" aria-labelledby="addMoneyModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="addMoneyModalLabel">Add Money to Wallet</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label for="amount">Enter Amount (₹)</label>
                                    <input type="number" class="form-control" id="amount" placeholder="Min ₹1" min="1" step="any">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary" id="proceedToPay">Proceed to Pay</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transaction History -->
                <div class="card" style="border: none; box-shadow: 0 0 15px rgba(0,0,0,0.05); border-radius: 8px;">
                    <div class="card-body" style="padding: 30px;">
                        <h3 style="font-size: 20px; font-weight: 600; margin-bottom: 20px;">Transaction History</h3>
                        <% if(wallet.transactions && wallet.transactions.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover mt-3" style="border: 1px solid #eee;">
                                    <thead style="background-color: #f8f9fa;">
                                        <tr>
                                            <th style="font-weight: 600; color: #555;">Date</th>
                                            <th style="font-weight: 600; color: #555;">Description</th>
                                            <th style="font-weight: 600; color: #555;">Amount</th>
                                            <th style="font-weight: 600; color: #555;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% wallet.transactions.forEach(t => { %>
                                            <tr>
                                                <td style="vertical-align: middle;">
                                                    <%= t.date.toLocaleDateString() %><br>
                                                    <small class="text-muted"><%= t.date.toLocaleTimeString() %></small>
                                                </td>
                                                <td style="vertical-align: middle;"><%= t.description %></td>
                                                <td style="vertical-align: middle;">
                                                    <% if(t.type === 'Credit') { %>
                                                        <span class="text-success" style="font-weight: bold;">+₹<%= t.amount.toFixed(2) %></span>
                                                    <% } else { %>
                                                        <span class="text-danger" style="font-weight: bold;">-₹<%= t.amount.toFixed(2) %></span>
                                                    <% } %>
                                                </td>
                                                <td style="vertical-align: middle;">
                                                    <span style="background-color: #e8f5e9; color: #2e7d32; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold;">Completed</span>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info mt-3 text-center" style="background-color: #f8f9fa; border: 1px dashed #ccc; color: #666; padding: 30px;">
                                You have no transactions in your wallet yet!
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
  </div>

  <script src="/js/jquery.min.js"></script>
  <script src="/js/popper.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/jquery.easing.1.3.js"></script>
  <script src="/js/jquery.waypoints.min.js"></script>
  <script src="/js/jquery.flexslider-min.js"></script>
  <script src="/js/owl.carousel.min.js"></script>
  <script src="/js/jquery.magnific-popup.min.js"></script>
  <script src="/js/magnific-popup-options.js"></script>
  <script src="/js/bootstrap-datepicker.js"></script>
  <script src="/js/jquery.stellar.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <script>
    $(document).ready(function() {
        $('#proceedToPay').on('click', async function() {
            const amount = $('#amount').val();
            
            if (!amount || isNaN(amount) || amount <= 0) {
                Swal.fire('Error', 'Please enter a valid amount greater than 0.', 'error');
                return;
            }

            try {
                // 1. Create Order
                const response = await fetch('/wallet/add-money', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount })
                });

                const data = await response.json();
                
                if (!data.success) {
                    Swal.fire('Error', data.message || 'Failed to initialize payment.', 'error');
                    return;
                }

                // 2. Open Razorpay Checkout
                if (typeof Razorpay === 'undefined') {
                    Swal.fire('Error', 'Razorpay SDK failed to load. Please check your internet connection or disable ad-blockers.', 'error');
                    return;
                }

                const options = {
                    key: '<%= razorpayKeyId %>',
                    amount: data.order.amount,
                    currency: data.order.currency,
                    name: 'Footwear Wallet Top-up',
                    description: `Adding ₹${amount} to your wallet`,
                    order_id: data.order.id,
                    handler: async function (response) {
                        try {
                            // 3. Verify Payment
                            const verifyRes = await fetch('/wallet/verify-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature,
                                    amount: amount
                                })
                            });

                            const verifyData = await verifyRes.json();
                            
                            if (verifyData.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: 'Wallet topped up successfully!',
                                    confirmButtonText: 'Great'
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire('Error', verifyData.message || 'Verification failed.', 'error');
                            }
                        } catch (verifyErr) {
                            console.error('Verification Error:', verifyErr);
                            Swal.fire('Error', 'Payment verification failed. Please contact support if your money was deducted.', 'error');
                        }
                    },
                    prefill: {
                        name: '<%= locals.user ? locals.user.full_name : "" %>',
                        email: '<%= locals.user ? locals.user.email : "" %>'
                    },
                    theme: { color: '#88c8bc' }
                };

                const rzp = new Razorpay(options);
                rzp.on('payment.failed', function (response){
                    console.error('Payment Failed:', response.error);
                    Swal.fire('Payment Failed', response.error.description, 'error');
                });
                rzp.open();
                $('#addMoneyModal').modal('hide');

            } catch (err) {
                console.error('Wallet Top-up Unexpected Error:', err);
                Swal.fire('Error', 'An unexpected error occurred. Please check the console or try again.', 'error');
            }
        });
    });
  </script>
</body>
</html>
